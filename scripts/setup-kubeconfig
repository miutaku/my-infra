#!/usr/bin/env bash
# 各クラスタから kubeconfig を取得して ~/.kube/config に統合する
# Usage:
#   setup-kubeconfig             # home-k8s + OKE 両方
#   setup-kubeconfig --home-k8s-only
#   setup-kubeconfig --oke-only
set -euo pipefail

export OCI_CLI_SUPPRESS_FILE_PERMISSIONS_WARNING=True
export SUPPRESS_LABEL_WARNING=True

KUBE_DIR="$HOME/.kube"
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
HOME_K8S_YAML="$KUBE_DIR/home-k8s.yaml"
OKE_YAML="$KUBE_DIR/oke.yaml"
MERGED="$KUBE_DIR/config"

# home-k8s: Talosで生成した管理者kubeconfigを利用する。
HOME_K8S_KUBECONFIG_SOURCE="${HOME_K8S_KUBECONFIG_SOURCE:-$REPO_DIR/talos/green/.generated/kubeconfig}"

# OKE: クラスタ OCID (terraform apply 後に固定)
OKE_CLUSTER_OCID="${OKE_CLUSTER_OCID:-ocid1.cluster.oc1.ap-tokyo-1.aaaaaaaaxroxdjngbtuj63b3rqlczoidrjvu2cnlpqv7euzi6cl7a5hbbwnq}"
OCI_REGION="${OCI_REGION:-ap-tokyo-1}"

fetch_home_k8s() {
  echo "[home-k8s] ${HOME_K8S_KUBECONFIG_SOURCE} から kubeconfig を取得..."
  [[ -f "$HOME_K8S_KUBECONFIG_SOURCE" ]] || {
    echo "home-k8s kubeconfigがありません: $HOME_K8S_KUBECONFIG_SOURCE" >&2
    exit 1
  }
  cp "$HOME_K8S_KUBECONFIG_SOURCE" "$HOME_K8S_YAML"
  chmod 600 "$HOME_K8S_YAML"

  local current_ctx
  current_ctx=$(kubectl --kubeconfig "$HOME_K8S_YAML" config current-context)
  if [[ "$current_ctx" != "home-k8s" ]]; then
    kubectl --kubeconfig "$HOME_K8S_YAML" config rename-context "$current_ctx" home-k8s
  fi
  echo "[home-k8s] 完了 (context: home-k8s)"
}

fetch_oke() {
  echo "[oke] OKE kubeconfig を取得..."
  # 既存ファイルがあると merge されてコンテキスト名が衝突するため先に削除
  rm -f "$OKE_YAML"
  oci ce cluster create-kubeconfig \
    --cluster-id "$OKE_CLUSTER_OCID" \
    --file "$OKE_YAML" \
    --region "$OCI_REGION" \
    --kube-endpoint PUBLIC_ENDPOINT
  chmod 600 "$OKE_YAML"

  local current_ctx
  current_ctx=$(kubectl --kubeconfig "$OKE_YAML" config current-context)
  if [[ "$current_ctx" != "oke-cloud" ]]; then
    kubectl --kubeconfig "$OKE_YAML" config rename-context "$current_ctx" oke-cloud
  fi
  echo "[oke] 完了 (context: oke-cloud)"
}

merge() {
  local configs=()
  [[ -f "$HOME_K8S_YAML" ]] && configs+=("$HOME_K8S_YAML")
  [[ -f "$OKE_YAML"  ]] && configs+=("$OKE_YAML")

  if [[ ${#configs[@]} -eq 0 ]]; then
    echo "統合対象の kubeconfig がありません。" >&2
    exit 1
  fi

  local joined
  joined=$(IFS=: ; echo "${configs[*]}")
  KUBECONFIG="$joined" kubectl config view --flatten > "$MERGED"
  chmod 600 "$MERGED"

  local contexts
  contexts=$(kubectl --kubeconfig "$MERGED" config get-contexts -o name | tr '\n' ' ')
  echo "[merge] ~/.kube/config 更新完了 (contexts: $contexts)"
}

case "${1:-all}" in
  --home-k8s-only) fetch_home_k8s ;;
  --oke-only)      fetch_oke      ;;
  all|*)
    fetch_home_k8s
    fetch_oke
    ;;
esac

merge
