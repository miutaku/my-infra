[Unit]
Description=ReVenter replicated monitoring storage and query gateway
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/reventer-observability
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose --profile grafana stop
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
