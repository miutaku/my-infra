views {
  view index {
    title '01 概要 / 責務から詳細へ'
    description '01 概要 / 責務から詳細へ'
    include user, home, edge, control, oke, data, monitoring, network, hardware
    global predicate runtimeLinks
    include home with { navigateTo home_apps }
    include edge with { navigateTo access }
    include control with { navigateTo delivery }
    include oke with { navigateTo oke_platform }
    include data with { navigateTo storage }
    include monitoring with { navigateTo observability }
    include network with { navigateTo network_topology }
    include hardware with { navigateTo power }
    autoLayout LeftRight
  }

  view home_apps of home {
    title '02 論理構成 / homeサービス'
    description '02 論理構成 / homeサービス'
    include home.*
    global predicate runtimeLinks
    include home.tnlastation with { navigateTo media }
    include home.loockit with { navigateTo loockit }
    autoLayout LeftRight
  }

  view access of edge {
    title '03 アクセス / 公開・Access・mTLS'
    description '03 アクセス / 公開・Access・mTLS'
    include user, edge.*, home.nextcloud, home.tnlastation, home.epgstation, home.loockit, home.wol, home.coupon_manager
    global predicate runtimeLinks
    autoLayout LeftRight
  }

  view admin_access of edge {
    title '03 アクセス / 管理hostname'
    description '03 アクセス / 管理hostname'
    include operator, edge.access, edge.tunnel, edge.connector, hardware.x570, hardware.b550m, hardware.kvm1, hardware.kvm2, network.unifi, network.router, network.ap, data.nas
    global predicate runtimeLinks
    autoLayout LeftRight
  }

  view media of home.tnlastation {
    title '03 アクセス / 録画・encoder・streaming'
    description '03 アクセス / 録画・encoder・streaming'
    include home.tnlastation.*, home.postgres, home.mirakurun, home.mirakurun_tuner, home.epgstation, home.mariadb
    global predicate runtimeLinks
    autoLayout LeftRight
  }

  view loockit of home.loockit {
    title '03 アクセス / proxyとBLE LXC'
    description '03 アクセス / proxyとBLE LXC'
    include user, edge.mtls, edge.tunnel, edge.connector, home.loockit, home.loockit_bridge
    global predicate runtimeLinks
    autoLayout LeftRight
  }

  view delivery of control {
    title '04 運用 / CI・TFC agent・GitOps'
    description '04 運用 / CI・TFC agent・GitOps'
    include control.*, oke.api, oke.argo, hardware.x570, hardware.b550m, monitoring.remoteMetrics, oke.vcn
    global predicate deliveryLinks
    autoLayout LeftRight
  }

  view gitops_apps {
    title '04 運用 / 全Applicationへの同期'
    description 'サービス一覧はモデルに残し、通常アクセスビューでは関係を絞る。'
    include control.argo, home.*, control.git, oke.api, control.agent, control.revagent, control.updater, control.arc, control.runnerInfra, control.runnerRev, control.eso, edge.connector, monitoring.homeVM, monitoring.vmagent, monitoring.pdc, data.restic
    global predicate deliveryLinks
    autoLayout LeftRight
  }

  view secrets of control.bws {
    title '04 運用 / bootstrap・BWS・SDK・ESO'
    description '04 運用 / bootstrap・BWS・SDK・ESO'
    include control.bootstrap, control.ci, control.ansible, control.bws, control.sdk, control.eso, control.secrets, oke.sdk, oke.eso, oke.secrets, oke.apps, home.nextcloud, home.tnlastation
    global predicate secretsLinks
    autoLayout LeftRight
  }

  view oke_platform of oke {
    title '04 運用 / OKE共通基盤と所有境界'
    description 'PRD OKE・アプリ・Autoscalerはreventer所有。STG ArgoCDは共通基盤管理。利用者経路と管理経路は個別ビューで確認。'
    include oke.*, control.argo, control.git, control.bws
    autoLayout LeftRight
  }

  view observability of monitoring {
    title '05 監視 / homeとOCIの収集・query'
    description '05 監視 / homeとOCIの収集・query'
    include monitoring.*, home.blackbox_exporter, home.nut_exporter, home.prometheus_node_exporter, home.pve_exporter, home.snmp_exporter, home.speedtest_exporter, home.tinytuya_exporter
    global predicate observabilityLinks
    autoLayout LeftRight
  }

  view exporter_targets extends observability {
    title '05 監視 / exporterの対象'
    description '05 監視 / exporterの対象'
    include hardware.x570, hardware.b550m, hardware.nut1, hardware.nut2, network.router, network.switch, network.ap, network.iot
    autoLayout LeftRight
  }

  view storage of data {
    title '05 保存 / NFS・restic・PBS'
    description '05 保存 / NFS・restic・PBS'
    include data.*, home.nextcloud, home.epgstation, home.tnlastation.backend, home.tnlastation.encoder, home.tnlastation.stream, hardware.x570, hardware.b550m
    global predicate storageLinks
    autoLayout LeftRight
  }

  view network_topology of network {
    title '06 ネットワーク / VLANと管理経路'
    description '06 ネットワーク / VLANと管理経路'
    include network.*, hardware.x570, hardware.b550m, hardware.worker3, hardware.worker4, edge.warp, user, home.coredns
    global predicate networkLinks
    autoLayout LeftRight
  }

  view power of hardware {
    title '06 電源 / UPSとNUTの別責務'
    description '電源供給だけを表示。NUT statusとshutdown関係は要素のrelationship browserで確認できる。'
    include hardware.upsA, hardware.upsB, hardware.nut1, hardware.nut2, hardware.x570, hardware.b550m, network.switch
    global predicate hardwareLinks
    autoLayout LeftRight
  }
}
