views {
  style * { size xs textSize md padding sm }
  style premises.management, external.bws, external.edge { color amber }
  style premises.home.agent { color green }
  style premises.pve { color green }
  style consumers { color muted }
  deployment view index {
    title '自宅インフラの全体'
    description 'Proxmox VEクラスタにhome-k8sのVM・TrueNAS・PBSを配置。Raspberry Piもhome-k8sのworker。クラスタから全VM/LXC、ネットワーク機器から配線・VLAN、各サービスから内部構成へ進めます。'
    include homeSite, homeSite.pve, homeSite.pve.controlplanes.cp1, homeSite.pve.workers.worker1, homeSite.pve.controlplanes.cp2, homeSite.pve.controlplanes.cp3, homeSite.pve.workers.worker2, homeSite.pve.storage.nas1, homeSite.pve.storage.nas2, homeSite.pve.storage.pbs, homeSite.workers, homeSite.network, providers, providers.cloudflare, providers.bitwarden, providers.idrive
    include providers.cloudflare with { description 'Access・Tunnel / 公開入口' }
    include providers.bitwarden with { description '秘密情報の管理・配布' }
    include providers.idrive with { description 'S3互換のバックアップ保存先' }
    include homeSite.pve.storage.nas1 with { title 'nas-01 / TrueNAS VM69001' description 'runner cache用NFS / VLAN20' }
    include homeSite.pve.storage.nas2 with { title 'nas-02 / TrueNAS VM69002' description 'アプリ・録画データ用NFS / VLAN20' }
    include homeSite.workers with { description 'Talos Linux / arm64' }
    include homeSite.pve with { navigateTo placement }
    include homeSite.network with { navigateTo network }
    exclude * -> * where tag is not #topology
    autoLayout LeftRight 60 45
  }
  view home_apps of premises.home {
    title 'home-k8sのサービスと接続'
    description 'home-k8s内のサービス・DB・監視・運用基盤。チューナーとLoockitの実機制御はPVEのLXC、MagicMirror表示は専用VM。サービスをクリックすると内部へ。'
    include premises.pve
    include external.edge, premises.home, premises.home.platform, premises.home.agent, premises.home.management, premises.home.eso, premises.home.dns, premises.home.nextcloud, premises.home.recording, premises.home.loockit, premises.home.coupon_manager, premises.home.magic_mirror, premises.home.wol, premises.home.annict_scraper, premises.home.databases, premises.pve.nas02, premises.pve.kiosk, external.annict
    include premises.home.agent with { navigateTo observability }
    include premises.home.management with { navigateTo delivery }
    include premises.home.eso with { navigateTo secrets }
    include premises.home.dns with { navigateTo platform }
    include premises.home.platform with { navigateTo platform }
    include premises.home.nextcloud with { navigateTo nextcloud }
    include premises.home.recording with { navigateTo recording }
    include premises.home.loockit with { navigateTo loockit }
    include premises.home.databases, premises.pve.nas02 with { navigateTo storage }
    include external.edge with { navigateTo access }
    exclude external.edge.tunnel -> premises.home.**
    exclude external.edge.routes.** -> *
    exclude * -> * where kind is not runtime and kind is not provide
    exclude premises.home.** -> premises.home.**
    exclude premises.home.** -> premises.pve.**
    exclude premises.home.coupon_manager.** -> *
    autoLayout LeftRight 55 40
  }
  view access {
    title '入口・認証 / 原則Access・例外mTLS'
    description '公開hostnameはAccessで認証してTunnelへ。loockit-apiだけは専用クライアント証明書と操作制限によるmTLS。WARP・LANの直接経路はネットワークへ。認証方式と利用・管理の線種は別。'
    include user, operator, client, external.edge.access, external.edge.mtls, external.edge.tunnel, external.edge.routes.protected, external.edge.routes.exceptions, premises.home, premises.hardware, premises.pve, premises.home.management.argo, consumers.reventer
    include external.edge.routes.protected with { navigateTo home_apps }
    include premises.home with { navigateTo home_apps }
    include premises.hardware with { navigateTo placement }
    include premises.hardware.network with { navigateTo network }
    include premises.pve with { navigateTo storage }
    exclude external.edge.tunnel -> premises.**
    exclude external.edge.tunnel -> premises.management.**
    exclude premises.** -> premises.**
    exclude * -> * where kind is not runtime and kind is not admin and kind is not connect and kind is not authenticate
    autoLayout LeftRight 100 80
  }
  view delivery {
    title '自宅基盤の変更・同期'
    description 'my-infra自身の自宅基盤の変更・同期。Re:Venter向けのGitOps・CI・Terraformの詳細は利用側の図へ。ここでは共用Controllerとの接点だけを示す。'
    include premises.home.management.argo, premises.home.management.runner, premises.home.management.tfc_agents, premises.management.ansible, premises.home.management.images, premises.management.packer, external.github, external.terraform_cloud, external.github_pages, premises.home, premises.hardware, premises.pve, external.edge
    include premises.home with { navigateTo home_apps }
    include premises.hardware with { navigateTo placement }
    include premises.hardware.network with { navigateTo network }
    exclude external.edge.routes.** -> *
    exclude * -> * where kind is not deploy
    autoLayout TopBottom 80 60
  }
  view secrets {
    title '秘密情報の管理・注入'
    description 'BWSと共通ESO・SecretStoreを基盤として提供。利用側のSecret定義やアプリ設定はここでは展開しない。'
    include external.bws, premises.home.eso, external.github, external.terraform_cloud, premises.management.ansible, premises.home.backups
    exclude external.edge.routes.** -> *
    exclude * -> * where kind is not secret
    autoLayout LeftRight 80 60
  }
  view observability {
    title '監視の収集・保存・照会'
    description '共用の自宅監視基盤の収集・保存・照会。Re:Venter専用のOCI監視VM・PDC・データ保存構成はreventer側の図に集約。'
    include operator, external.grafana, premises.hardware, premises.home.agent, premises.home.agent.collector, premises.home.agent.local_store, premises.home.agent.pdc, premises.home.agent.exporters
    exclude external.edge.routes.** -> *
    exclude * -> * where kind is not observe and kind is not query and kind is not connect
    autoLayout LeftRight 80 60
  }
  deployment view placement {
    title 'Proxmox VEクラスタ / 全VM・LXC'
    description '2ノードの共通クラスタ内でVM/LXCを役割別に分類。各ゲストにVLANを記載し、詳細に配置ホストを保持。home-k8s VM内はTalos Linux、LXC内はDockerサービス。'
    include homeSite.pve, homeSite.pve.controlplanes, homeSite.pve.workers, homeSite.pve.loadbalancers, homeSite.pve.storage, homeSite.pve.smartlocks, homeSite.pve.tuners, homeSite.pve.network_management, homeSite.pve.development, homeSite.pve.desktop, homeSite.pve.display, homeSite.pve.controlplanes.cp1, homeSite.pve.controlplanes.cp2, homeSite.pve.controlplanes.cp3, homeSite.pve.workers.worker1, homeSite.pve.workers.worker2, homeSite.pve.loadbalancers.lb1, homeSite.pve.loadbalancers.lb2, homeSite.pve.storage.nas1, homeSite.pve.storage.nas2, homeSite.pve.storage.pbs, homeSite.pve.smartlocks.loockit1, homeSite.pve.smartlocks.loockit2, homeSite.pve.tuners.tuner_prod, homeSite.pve.tuners.tuner_stg, homeSite.pve.network_management.unifi, homeSite.pve.development.dev, homeSite.pve.desktop.windows, homeSite.pve.display.kiosk, homeSite.pve.controlplanes.cp1.talos, homeSite.pve.controlplanes.cp2.talos, homeSite.pve.controlplanes.cp3.talos, homeSite.pve.workers.worker1.talos, homeSite.pve.workers.worker2.talos, homeSite.pve.smartlocks.loockit1.app, homeSite.pve.smartlocks.loockit2.app, homeSite.pve.tuners.tuner_prod.app, homeSite.pve.tuners.tuner_stg.app, homeSite.pve.network_management.unifi.app
    exclude homeSite.pve.bluez1, homeSite.pve.bluez2
    exclude * -> *
    autoLayout TopBottom 45 35
  }


  view network of premises.hardware.network {
    title 'ネットワーク機器 / ルーター・SW・AP'
    description 'IX2215の配下に宅内Ethernet・SW・AP。PVEはnativeで管理し、VMごとに802.1Q tagを設定。線はLAN接続を表す。ルーターをクリックしてセグメント・ACLへ。'
    include premises.pve with { navigateTo placement }
    include premises, external.internet, premises.hardware.network, premises.hardware.network.*, premises.pve, premises.pve.unifi
    include premises.hardware.network.router with { navigateTo vlans }
    exclude external.edge.routes.** -> *
    exclude * -> * where kind is not network and kind is not admin
    autoLayout TopBottom 80 60
  }
  deployment view vlans {
    title 'VLAN / native・タグ・経路'
    description '枠の内側が同じVLAN。物理機器・端末・Service IPと、集約したPVE利用側を表示。PVEをクリックして全VM・CTへ。DHCP予約は設定上の割当であり、接続中端末の一覧ではありません。'
    include homeSite.lan, homeSite.lan.*, homeSite.lan.native.pve, homeSite.lan.native.pve_management, homeSite.lan.native.switch, homeSite.lan.native.ap, homeSite.lan.management.rpi_workers, homeSite.lan.management.nut, homeSite.lan.management.kvm, homeSite.lan.management.management_clients, homeSite.lan.server.pve, homeSite.lan.server.service_ips, homeSite.lan.server.vips, homeSite.lan.client.pve, homeSite.lan.client.physical_clients, homeSite.lan.client.wol, homeSite.lan.guest.clients, homeSite.lan.iot.pve, homeSite.lan.iot.av, homeSite.lan.iot.smart_home, homeSite.ix2215, providers.warp
    exclude homeSite.lan.native.native, homeSite.lan.management.management, homeSite.lan.server.server, homeSite.lan.client.client, homeSite.lan.guest.guest, homeSite.lan.iot.iot
    include homeSite.ix2215 with { navigateTo network }
    exclude * -> * where tag is not #vlan
    autoLayout TopBottom 60 40
  }

  view platform of premises.home.platform {
    title 'home-k8s / クラスタ基盤'
    description 'control-planeのAPIがworkerを制御し、CNI・Service転送・DNSがPodを支える。metrics-server・CSR承認・descheduler、ArgoCD/ARC/ESOがAPIへ働きかける。内部DNSとクラスタDNSは別。'
    include premises.home.platform.*, premises.home.dns.metallb, premises.home.dns.coredns, external.public_dns, premises.home.eso, external.bws, premises.home.management.argo, premises.home.management.runner, external.edge, premises.lan.server
    include premises.home.management.argo, premises.home.management.runner with { navigateTo delivery }
    include premises.home.eso with { navigateTo secrets }
    include premises.home.dns.metallb with { navigateTo network }
    include external.edge with { navigateTo access }
    exclude external.edge.routes.** -> *
    exclude external.edge.tunnel -> premises.**
    exclude * -> * where kind is backup or kind is power
    autoLayout LeftRight 60 50
  }
  view loockit of premises.home.loockit {
    title 'Loockit / HAProxy → LXC → Bluetooth'
    description '外部APIはmTLS。Pod内HAProxyはreadyzでactiveだけを選択し、LXC 12902/12903のREST/gRPCへ転送。LXCがPVE上のBlueZを使い、Leaseでleaderを選ぶ。'
    include premises.pve
    include client, external.edge.mtls, external.edge.tunnel, premises.home.loockit.proxy, premises.pve.loockit_a, premises.pve.loockit_b, premises.pve.bluez, premises.home.platform.api
    include premises.home.platform.api with { navigateTo platform }
    include premises.pve.loockit_a with { navigateTo placement }
    include premises.pve.loockit_b with { navigateTo placement }
    exclude external.edge.routes.** -> *
    autoLayout LeftRight 60 50
  }
  view recording of premises.home.recording {
    title '録画・配信 / PRD・STG'
    description 'TNLaStation・EPGStationはKubernetes Service名でMirakurun LXCへ接続。PRDは192.168.20.132、STGは192.168.20.142。STG MirakurunのBS/CSはPRDへのfallback。録画領域はnas-02上で分離。'
    include premises.pve
    include premises.home, premises.home.recording, premises.home.recording.epgstation, premises.home.recording.tnlastation, premises.home.recording.tnlastation_staging, premises.pve.tuner_prod, premises.pve.tuner_stg
    include premises.home.recording.tnlastation with { navigateTo recording_prd }
    include premises.home.recording.tnlastation_staging with { navigateTo recording_stg }
    include premises.pve.tuner_prod, premises.pve.tuner_stg with { navigateTo placement }
    exclude external.edge.routes.** -> *
    exclude * -> * where kind is not runtime
    autoLayout LeftRight 55 40
  }
  view nextcloud of premises.home.nextcloud {
    title 'Nextcloud / DB・ロック・ファイル保存'
    description 'Access認証後のHTTPをNextcloudへ。MariaDBはメタデータ、Redisはlocking/cache、ファイルはnas-02のNFS PVC。オンライン保存とバックアップは保存図で分ける。'
    include premises.pve
    include external.edge, premises.home.nextcloud, premises.home.nextcloud.*, premises.home.databases.mariadb, premises.pve.nas02
    include premises.pve.nas02 with { navigateTo storage }
    exclude external.edge.routes.** -> *
    exclude * -> * where kind is not runtime
    autoLayout LeftRight 60 50
  }

  view storage {
    title '保存・バックアップ / 復元元の区別'
    description 'VMはPBS、DBはlogical dump、NASはrestic、録画は専用job、監視はsnapshotでバックアップ。オンラインのNFSアクセスは「NFSの利用経路」へ。'
    include premises.pve, premises.pve.nas02, premises.pve.pbs, premises.pve.backup_sources, premises.home.recording, premises.home.databases, premises.home.agent.local_store, premises.home.backups, premises.home.backups.*, external.idrive
    include premises.pve.nas02, premises.pve.pbs with { navigateTo placement }
    exclude external.edge.routes.** -> *
    exclude * -> * where kind is not backup
    autoLayout LeftRight 80 60
  }
  view nfs {
    title 'NFSの利用経路 / nas-01・nas-02'
    description 'nas-01はrunner cache、nas-02はアプリ・DB・録画・監視のオンライン保存先。バックアップの経路は「復元元の区別」へ。'
    include premises.pve, premises.pve.nas01, premises.pve.nas02, premises.home, premises.home.shared, premises.home.nextcloud, premises.home.recording.epgstation, premises.home.recording.tnlastation, premises.home.recording.tnlastation_staging, premises.home.databases, premises.home.agent.local_store, premises.home.coupon_manager
    include premises.pve.nas01, premises.pve.nas02 with { navigateTo storage }
    exclude * -> * where tag is not #nfs
    autoLayout LeftRight 80 60
  }
  view power {
    title '電源・安全停止 / UPS・NUTのcross-power'
    include premises.pve with { navigateTo placement }
    include premises.hardware.ups, premises.hardware.ups.*, premises.hardware.network
    exclude external.edge.routes.** -> *
    exclude * -> * where kind is not power and kind is not network and kind is not query
    exclude premises.hardware.network -> * where kind is network
    autoLayout LeftRight 80 60
  }
  view recording_prd of premises.home.recording.tnlastation {
    title 'TNLaStation PRD / 制御・エンコード・配信'
    description 'GatewayからWeb・API・HLSへ。APIが録画とffmpeg workerを制御し、専用DBとnas-02の録画領域を使用。'
    include premises.pve
    include premises.home, premises.home.recording.tnlastation, premises.home.recording.tnlastation.*, premises.pve.tuner_prod, premises.home.databases.postgres, premises.pve.nas02
    include premises.pve.nas02 with { navigateTo storage }
    exclude external.edge.routes.** -> *
    exclude * -> * where kind is not runtime
    autoLayout LeftRight 55 40
  }
  view recording_stg of premises.home.recording.tnlastation_staging {
    title 'TNLaStation STG / 制御・エンコード・配信'
    description 'GatewayからWeb・API・HLSへ。APIが録画とffmpeg workerを制御し、専用DBとnas-02の録画領域を使用。'
    include premises.pve
    include premises.home, premises.home.recording.tnlastation_staging, premises.home.recording.tnlastation_staging.*, premises.pve.tuner_stg, premises.home.databases.postgres_staging, premises.pve.nas02
    include premises.pve.nas02 with { navigateTo storage }
    exclude external.edge.routes.** -> *
    exclude * -> * where kind is not runtime
    autoLayout LeftRight 55 40
  }
}
