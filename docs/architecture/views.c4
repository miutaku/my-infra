views {
  style * { size xs textSize md padding sm }
  style control, external.bws, external.edge { color amber }
  style monitoring { color green }
  style premises.data, shared_prd { color gray }
  style consumers { color muted }
  view index {
    title 'インフラ基盤の全体'
    description 'my-infraが提供する実行・保存・監視・運用基盤。自宅サービスの入口は原則Access → Tunnel。Re:Venterは基盤の利用側として接点のみ示す。mTLSなどの例外は入口・認証から確認。'
    include user, operator, external.edge.access, external.edge.tunnel, external.bws, premises.home, premises.data.nas, oke, shared_prd, monitoring.vms, control, consumers.reventer
    include external.edge.access with { navigateTo access }
    include external.edge.tunnel with { navigateTo access }
    include premises.home with { navigateTo home_apps }
    include control with { navigateTo delivery }
    include external.bws with { navigateTo secrets }
    include monitoring.vms with { navigateTo observability }
    include oke, shared_prd with { navigateTo placement }
    include premises.data.nas with { navigateTo storage }
    exclude external.edge.routes.** -> *
    exclude oke.eso -> consumers.reventer
    exclude shared_prd.eso -> consumers.reventer
    exclude premises.home.** -> premises.data.**
    exclude * -> * where kind is not runtime and kind is not admin and kind is not authenticate and kind is not provide and kind is not secret
    rank source { user, operator }
    autoLayout TopBottom 100 80
  }
  view home_apps of premises.home {
    title '自宅基盤・利用するサービス'
    description '共通入口と基盤の利用先。公開UIはAccess → Tunnel、内部DNS・NFS・DBは宅内の経路。アプリの処理フローとデプロイ経路は混ぜない。'
    include user, operator, external.edge.access, external.edge.tunnel, premises.home, premises.home.nextcloud, premises.home.recording, premises.home.apps, premises.home.dns, premises.data.nas, premises.data.databases, control.argo
    include external.edge.access with { navigateTo access }
    include premises.data.nas with { navigateTo storage }
    include premises.home.dns with { navigateTo network }
    include control.argo with { navigateTo delivery }
    exclude premises.home.** -> premises.home.**
    exclude external.edge.routes.** -> *
    exclude * -> * where kind is not runtime and kind is not admin and kind is not authenticate
    autoLayout LeftRight 80 60
  }
  view access {
    title '入口・認証 / 原則Access・例外mTLS'
    description '公開hostnameはAccessで認証してTunnelへ。loockit-apiだけは専用クライアント証明書と操作制限によるmTLS。WARP・LANの直接経路はネットワークへ。認証方式と利用・管理の線種は別。'
    include user, operator, client, external.edge.access, external.edge.mtls, external.edge.tunnel, external.edge.routes.protected, external.edge.routes.exceptions, premises.home, premises.hardware, premises.data.nas, control.argo, control.reviews
    include external.edge.routes.protected with { navigateTo home_apps }
    include premises.home with { navigateTo home_apps }
    include premises.hardware with { navigateTo placement }
    include premises.data.nas with { navigateTo storage }
    exclude external.edge.tunnel -> premises.**
    exclude external.edge.tunnel -> control.**
    exclude premises.** -> premises.**
    exclude * -> * where kind is not runtime and kind is not admin and kind is not connect and kind is not authenticate
    autoLayout LeftRight 100 80
  }
  view delivery {
    title '変更・デプロイ'
    description '基盤の構成変更と、利用側の実行・同期を受託する接点。アプリの内部構成は利用側リポジトリで管理。'
    include control.argo, control.runner, control.tfc_agents, control.ansible, control.images, control.packer, external.github, external.terraform_cloud, external.github_pages, premises.home, oke, oke.argo, oke.api, shared_prd, consumers.reventer, premises.hardware, external.edge, monitoring.vms
    include premises.home with { navigateTo home_apps }
    include premises.hardware with { navigateTo placement }
    exclude external.edge.routes.** -> *
    exclude * -> * where kind is not deploy
    autoLayout TopBottom 80 60
  }
  view secrets {
    title '秘密情報の管理・注入'
    description 'BWSと共通ESO・SecretStoreを基盤として提供。利用側のSecret定義やアプリ設定はここでは展開しない。'
    include external.bws, premises.home.eso, oke.eso, shared_prd.eso, consumers.reventer, external.github, external.terraform_cloud, control.ansible, premises.data.backups
    exclude external.edge.routes.** -> *
    exclude * -> * where kind is not secret
    autoLayout LeftRight 80 60
  }
  view observability {
    title '監視の収集・保存・照会'
    description '基盤が提供する自宅・OCIの保存先とGrafanaへの照会経路。利用側からのmetrics/logsは境界の一つの接点として扱う。'
    include operator, external.grafana, premises.hardware, premises.home.agent, premises.home.agent.collector, premises.home.agent.local_store, premises.home.agent.pdc, premises.home.agent.exporters, consumers.reventer, monitoring, monitoring.*
    exclude external.edge.routes.** -> *
    exclude * -> * where kind is not observe and kind is not query and kind is not connect
    autoLayout LeftRight 80 60
  }
  deployment view placement {
    title '基盤の配置 / 管理範囲'
    include homeSite, homeSite.x570, homeSite.x570.nas1, homeSite.x570.pbs, homeSite.b550m, homeSite.b550m.nas2, homeSite.talos, stg, prd
    exclude * -> *
    autoLayout TopBottom 80 60
  }
  view network {
    title 'ネットワーク / LAN・WARP・OCI'
    description 'WARPのprivate CIDR route、LANのL3接続、OCIのpublic/private subnetと出口。公開WebのAccess認証は入口・認証で扱う。'
    include operator, external.edge.warp, premises.lan, premises.lan.*, premises.hardware.router, premises.hardware.wifi, premises.hardware.unifi, premises.hardware.lb, premises.home.dns, premises.home.dns.coredns, premises.home.dns.metallb, oke.workers, oke.network, oke.network.*, external.internet, external.oracle
    exclude external.edge.routes.** -> *
    exclude * -> * where kind is not network and kind is not connect
    autoLayout LeftRight 80 60
  }
  view storage {
    title '保存・バックアップ / 復元元の区別'
    include premises.home.nextcloud, premises.home.recording, premises.home.agent.local_store, premises.data, premises.data.nas, premises.data.nas.nas01, premises.data.nas.nas02, premises.data.pbs, premises.data.databases, premises.data.databases.*, premises.data.shared, premises.data.backups, premises.data.backups.*, external.idrive, premises.hardware.x570, premises.hardware.b550m
    include premises.data.nas.nas01, premises.data.nas.nas02, premises.data.pbs with { navigateTo placement }
    exclude external.edge.routes.** -> *
    exclude * -> * where kind is not runtime and kind is not backup
    autoLayout LeftRight 80 60
  }
  view power {
    title '電源・安全停止 / UPS・NUTのcross-power'
    include premises.hardware.ups, premises.hardware.ups.*, premises.hardware.x570, premises.hardware.b550m
    exclude external.edge.routes.** -> *
    exclude * -> * where kind is not power and kind is not network and kind is not query
    autoLayout LeftRight 80 60
  }
}
