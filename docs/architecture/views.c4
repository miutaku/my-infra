views {
  style * { size xs textSize md padding sm }
  style premises.management, external.bws, external.edge { color amber }
  style premises.home.agent { color green }
  style premises.data { color gray }
  style consumers { color muted }
  view index {
    title 'インフラ基盤の全体'
    description 'my-infraが提供する実行・保存・監視・運用基盤。自宅サービスの入口は原則Access → Tunnel。Re:Venterの専用VM・監視・agent・runnerは利用側にまとめ、詳細はreventer側の図を参照。mTLSなどの例外は入口・認証から確認。'
    include user, operator, external.edge.access, external.edge.tunnel, external.bws, premises.home, premises.data.nas, premises.management.argo, premises.management.runner, consumers.reventer
    include external.edge.access with { navigateTo access }
    include external.edge.tunnel with { navigateTo access }
    include premises.home with { navigateTo home_apps }
    include premises.management.argo, premises.management.runner with { navigateTo delivery }
    include external.bws with { navigateTo secrets }
    include premises.data.nas with { navigateTo storage }
    exclude * -> consumers.reventer.definitions.**
    exclude external.edge.routes.** -> *
    exclude premises.home.** -> premises.data.**
    exclude * -> * where kind is not runtime and kind is not admin and kind is not authenticate and kind is not provide and kind is not secret
    rank source { user, operator }
    autoLayout TopBottom 100 80
  }
  view home_apps of premises.home {
    title '自宅基盤・サービスの分類'
    description '利用アプリ・クラスタ基盤・DNS/Secret・監視を用途別に分類。DB・バックアップ・共用運用もhome-k8sで稼働。要素を開いて詳細へ。経路は入口・認証、実行場所は配置で確認。'
    include premises.home.*, premises.data.databases, premises.data.backups, premises.management
    include premises.home.nextcloud, premises.home.recording with { navigateTo storage }
    include premises.home.apps with { navigateTo home_workloads }
    include premises.home.platform, premises.home.dns with { navigateTo platform }
    include premises.home.eso with { navigateTo secrets }
    include premises.home.agent with { navigateTo observability }
    include premises.data.databases, premises.data.backups with { navigateTo storage }
    include premises.management with { navigateTo delivery }
    exclude * -> *
    autoLayout TopBottom 60 50
  }
  view access {
    title '入口・認証 / 原則Access・例外mTLS'
    description '公開hostnameはAccessで認証してTunnelへ。loockit-apiだけは専用クライアント証明書と操作制限によるmTLS。WARP・LANの直接経路はネットワークへ。認証方式と利用・管理の線種は別。'
    include user, operator, client, external.edge.access, external.edge.mtls, external.edge.tunnel, external.edge.routes.protected, external.edge.routes.exceptions, premises.home, premises.hardware, premises.data.nas, premises.management.argo, consumers.reventer
    include external.edge.routes.protected with { navigateTo home_apps }
    include premises.home with { navigateTo home_apps }
    include premises.hardware with { navigateTo placement }
    include premises.hardware.network with { navigateTo network }
    include premises.data.nas with { navigateTo storage }
    exclude external.edge.tunnel -> premises.**
    exclude external.edge.tunnel -> premises.management.**
    exclude premises.** -> premises.**
    exclude * -> * where kind is not runtime and kind is not admin and kind is not connect and kind is not authenticate
    autoLayout LeftRight 100 80
  }
  view delivery {
    title '自宅基盤の変更・同期'
    description 'my-infra自身の自宅基盤の変更・同期。Re:Venter向けのGitOps・CI・Terraformの詳細は利用側の図へ。ここでは共用Controllerとの接点だけを示す。'
    include premises.management.argo, premises.management.runner, premises.management.tfc_agents, premises.management.ansible, premises.management.images, premises.management.packer, external.github, external.terraform_cloud, external.github_pages, premises.home, premises.hardware, external.edge
    include premises.home with { navigateTo home_apps }
    include premises.hardware with { navigateTo placement }
    include premises.hardware.network with { navigateTo network }
    exclude external.edge.routes.** -> *
    exclude * -> * where kind is not deploy
    autoLayout TopBottom 80 60
  }
  view secrets {
    title '秘密情報の管理・注入'
    description 'BWSと共通ESO・SecretStoreを基盤として提供。利用側のSecret定義やアプリ設定はここでは展開しない。'
    include external.bws, premises.home.eso, external.github, external.terraform_cloud, premises.management.ansible, premises.data.backups
    exclude external.edge.routes.** -> *
    exclude * -> * where kind is not secret
    autoLayout LeftRight 80 60
  }
  view observability {
    title '監視の収集・保存・照会'
    description '共用の自宅監視基盤の収集・保存・照会。Re:Venter専用のOCI監視VM・PDC・データ保存構成はreventer側の図に集約。'
    include operator, external.grafana, premises.hardware, premises.home.agent, premises.home.agent.collector, premises.home.agent.local_store, premises.home.agent.pdc, premises.home.agent.exporters
    exclude external.edge.routes.** -> *
    exclude * -> * where kind is not observe and kind is not query and kind is not connect
    autoLayout LeftRight 80 60
  }
  deployment view placement {
    title '基盤の配置 / PVE → VM → Talos'
    description 'PVEホストをクリックしてVM/LXCとその内側のTalos OSを見る。点線はクラスタ所属で、通信経路ではない。Podの配置先VMは固定しない。'
    include homeSite, homeSite.x570, homeSite.b550m, homeSite.worker_pi1, homeSite.worker_pi2, homeSite.talos, homeSite.network
    include homeSite.x570 with { navigateTo pve_x570 }
    include homeSite.b550m with { navigateTo pve_b550m }
    include homeSite.talos with { navigateTo home_apps }
    exclude * -> * where kind is not member
    autoLayout LeftRight 80 60
  }
  deployment view pve_x570 {
    title 'pve-x570 / VM・LXC・Talos OS'
    description '物理ホスト → VM/LXC → OS。Windows VM60000はIaC管理外だが稼働確認して追加。CP・workerの点線はhome-k8s所属。'
    include homeSite, homeSite.x570, homeSite.x570.*, homeSite.x570.cp1.talos, homeSite.x570.worker1.talos, homeSite.talos
    include homeSite.talos with { navigateTo home_apps }
    exclude homeSite.x570.x570, homeSite.b550m.b550m
    exclude * -> * where kind is not member
    autoLayout TopBottom 50 40
  }
  deployment view pve_b550m {
    title 'pve-b550m / VM・LXC・Talos OS'
    description '物理ホスト → VM/LXC → OS。CP VM2台とworker VM1台。TrueNASはこのPVE上のVM。'
    include homeSite, homeSite.b550m, homeSite.b550m.*, homeSite.b550m.cp2.talos, homeSite.b550m.cp3.talos, homeSite.b550m.worker2.talos, homeSite.talos
    include homeSite.talos with { navigateTo home_apps }
    exclude homeSite.x570.x570, homeSite.b550m.b550m
    exclude * -> * where kind is not member
    autoLayout TopBottom 50 40
  }
  view network of premises.hardware.network {
    title 'ネットワーク機器 / ルーター・SW・AP'
    description 'IX2215の配下に宅内Ethernet・SW・AP。PVEはnativeで管理し、VMごとに802.1Q tagを設定。線はLAN接続を表し、未確認のケーブルポートを断定しない。VLANをクリックしてセグメントへ。'
    include premises, external.internet, premises.hardware.network, premises.hardware.network.*, premises.hardware.x570, premises.hardware.x570.bridge, premises.hardware.b550m, premises.hardware.b550m.bridge, premises.hardware.unifi, premises.lan
    include premises.lan with { navigateTo vlans }
    include premises.hardware.x570 with { navigateTo pve_x570 }
    include premises.hardware.b550m with { navigateTo pve_b550m }
    exclude external.edge.routes.** -> *
    exclude * -> * where kind is not network and kind is not admin
    autoLayout TopBottom 80 60
  }
  view vlans of premises.lan {
    title 'VLAN / native・タグ・経路'
    description 'native1とtag10/20/30/31/40。PVEのゲストtagは稼働configで照合。guestの他VLAN向け通信は拒否。IoTのBVI名は4だがタグ40。各SSIDのVLAN割当は未確認。'
    include premises, premises.lan, premises.lan.*, premises.hardware.network.router, premises.hardware.network.switch, premises.hardware.x570.bridge, premises.hardware.b550m.bridge, external.edge.warp, premises.home.dns
    include premises.hardware.network.router, premises.hardware.network.switch with { navigateTo network }
    include premises.home.dns with { navigateTo platform }
    exclude external.edge.routes.** -> *
    exclude * -> * where kind is not network
    autoLayout LeftRight 80 60
  }
  view home_workloads of premises.home.apps {
    title '自宅の利用アプリ / Application全件から分類'
    description 'アプリ一覧は固定の選抜ではなく、ArgoCD定義を用途へ対応付ける。録画・Nextcloudは独立カテゴリ。未分類の新Applicationも自動生成し、一覧から追跡できる。'
    include premises.home.apps.*, premises.home.nextcloud, premises.home.recording, external.edge.access, external.edge.tunnel
    exclude external.edge.routes.** -> *
    exclude * -> * where kind is not runtime and kind is not authenticate
    autoLayout LeftRight 70 50
  }
  view platform of premises.home {
    title 'クラスタ基盤 / bootstrap・DNS・Secret・運用'
    description 'cluster.local用CoreDNSと宅内miutaku.internalは別。Flannel・kube-proxy・metrics-server・証明書承認も含める。metrics-server/証明書承認は稼働確認のみで導入宣言は未管理。ArgoCD・ARC・Terraform agentの詳細は基盤の変更へ。'
    include premises.home.platform.*, premises.home.dns.*, premises.home.eso, premises.management.argo, premises.management.runner, premises.management.tfc_agents
    include premises.home.dns with { navigateTo vlans }
    include premises.home.eso with { navigateTo secrets }
    include premises.management.argo, premises.management.runner, premises.management.tfc_agents with { navigateTo delivery }
    exclude * -> * where kind is not runtime and kind is not provide
    autoLayout TopBottom 70 50
  }
  view storage {
    title '保存・バックアップ / 復元元の区別'
    include premises.home.nextcloud, premises.home.recording, premises.home.agent.local_store, premises.data, premises.data.nas, premises.data.nas.nas01, premises.data.nas.nas02, premises.data.pbs, premises.data.databases, premises.data.databases.*, premises.data.shared, premises.data.backups, premises.data.backups.*, external.idrive, premises.hardware.x570, premises.hardware.b550m
    include premises.data.nas.nas01, premises.data.nas.nas02, premises.data.pbs with { navigateTo placement }
    exclude external.edge.routes.** -> *
    exclude * -> * where kind is not runtime and kind is not backup
    autoLayout LeftRight 80 60
  }
  view power {
    title '電源・安全停止 / UPS・NUTのcross-power'
    include premises.hardware.ups, premises.hardware.ups.*, premises.hardware.x570, premises.hardware.b550m
    exclude external.edge.routes.** -> *
    exclude * -> * where kind is not power and kind is not network and kind is not query
    autoLayout LeftRight 80 60
  }
}
