views {
  style * { size xs textSize md padding sm }
  style control, bws { color amber }
  style monitoring { color green }
  style data { color gray }
  style edge { color amber }
  view index {
    title '全体構成'
    description '利用者・管理者の入口から自宅サービス、OKE、保存、監視、秘密注入の関係。デプロイ経路はCI・デプロイへ分ける。'
    include user, operator, edge, edge.access, edge.tunnel, home, home.nextcloud, home.agent, home.eso, oke, control, control.argo, bws, monitoring, monitoring.vms, monitoring.grafana, data, data.nas
    include home with { navigateTo home_apps }
    include edge.tunnel with { navigateTo home_apps }
    include control.argo with { navigateTo delivery }
    include bws with { navigateTo secrets }
    include home.eso with { navigateTo secrets }
    include monitoring with { navigateTo observability }
    include oke with { navigateTo placement }
    include data with { navigateTo placement }
    exclude * -> * where kind is deploy or kind is backup
    rank source { user, operator, bws }
    autoLayout TopBottom 100 80
  }
  view home_apps of home {
    title '自宅のサービス・保存'
    include user, edge, home, home.nextcloud, home.recording, home.apps, home.dns, data, data.nas
    include data with { navigateTo placement }
    exclude * -> * where kind is not runtime
    autoLayout LeftRight 80 60
  }
  view delivery {
    title '変更・デプロイ'
    include control, control.*, home, oke, oke.argo, oke.scale, oke.api, reventer, hardware, edge, monitoring.vms
    include home with { navigateTo home_apps }
    include hardware with { navigateTo placement }
    exclude * -> * where kind is not deploy
    autoLayout TopBottom 80 60
  }
  view secrets {
    title '秘密情報の管理・注入'
    include bws, home, home.eso, oke, oke.eso, control.git, control.tfc
    exclude * -> * where kind is not secret
    autoLayout LeftRight 80 60
  }
  view observability {
    title '監視の収集・保存・照会'
    include operator, hardware, home.agent, oke, monitoring, monitoring.*
    exclude * -> * where kind is not observe and kind is not query
    autoLayout LeftRight 80 60
  }
  deployment view placement {
    title '配置 / 所有境界'
    include homeSite, stg, application
    exclude * -> *
    autoLayout LeftRight 80 60
  }
}
