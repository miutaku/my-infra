views {
  style * { size xs textSize md padding sm }
  style premises.management, external.bws, external.edge { color amber }
  style premises.home.agent { color green }
  style premises.data { color gray }
  style consumers { color muted }
  view index {
    title 'インフラ基盤の全体'
    description 'my-infraが提供する実行・保存・監視・運用基盤。自宅サービスの入口は原則Access → Tunnel。Re:Venterの専用VM・監視・agent・runnerは利用側にまとめ、詳細はreventer側の図を参照。mTLSなどの例外は入口・認証から確認。'
    include user, operator, external.edge.access, external.edge.tunnel, external.bws, premises.home, premises.data.nas, premises.management.argo, premises.management.runner, consumers.reventer
    include external.edge.access with { navigateTo access }
    include external.edge.tunnel with { navigateTo access }
    include premises.home with { navigateTo home_apps }
    include premises.management.argo, premises.management.runner with { navigateTo delivery }
    include external.bws with { navigateTo secrets }
    include premises.data.nas with { navigateTo storage }
    exclude * -> consumers.reventer.definitions.**
    exclude external.edge.routes.** -> *
    exclude premises.home.** -> premises.data.**
    exclude * -> * where kind is not runtime and kind is not admin and kind is not authenticate and kind is not provide and kind is not secret
    rank source { user, operator }
    autoLayout TopBottom 100 80
  }
  view home_apps of premises.home {
    title '自宅基盤・利用するサービス'
    description '共通入口と基盤の利用先。公開UIはAccess → Tunnel、内部DNS・NFS・DBは宅内の経路。アプリの処理フローとデプロイ経路は混ぜない。'
    include user, operator, external.edge.access, external.edge.tunnel, premises.home, premises.home.nextcloud, premises.home.recording, premises.home.apps, premises.home.dns, premises.data.nas, premises.data.databases, premises.management.argo
    include external.edge.access with { navigateTo access }
    include premises.data.nas with { navigateTo storage }
    include premises.home.dns with { navigateTo network }
    include premises.management.argo with { navigateTo delivery }
    exclude premises.home.** -> premises.home.**
    exclude external.edge.routes.** -> *
    exclude * -> * where kind is not runtime and kind is not admin and kind is not authenticate
    autoLayout LeftRight 80 60
  }
  view access {
    title '入口・認証 / 原則Access・例外mTLS'
    description '公開hostnameはAccessで認証してTunnelへ。loockit-apiだけは専用クライアント証明書と操作制限によるmTLS。WARP・LANの直接経路はネットワークへ。認証方式と利用・管理の線種は別。'
    include user, operator, client, external.edge.access, external.edge.mtls, external.edge.tunnel, external.edge.routes.protected, external.edge.routes.exceptions, premises.home, premises.hardware, premises.data.nas, premises.management.argo, consumers.reventer
    include external.edge.routes.protected with { navigateTo home_apps }
    include premises.home with { navigateTo home_apps }
    include premises.hardware with { navigateTo placement }
    include premises.data.nas with { navigateTo storage }
    exclude external.edge.tunnel -> premises.**
    exclude external.edge.tunnel -> premises.management.**
    exclude premises.** -> premises.**
    exclude * -> * where kind is not runtime and kind is not admin and kind is not connect and kind is not authenticate
    autoLayout LeftRight 100 80
  }
  view delivery {
    title '自宅基盤の変更・同期'
    description 'my-infra自身の自宅基盤の変更・同期。Re:Venter向けのGitOps・CI・Terraformの詳細は利用側の図へ。ここでは共用Controllerとの接点だけを示す。'
    include premises.management.argo, premises.management.runner, premises.management.tfc_agents, premises.management.ansible, premises.management.images, premises.management.packer, external.github, external.terraform_cloud, external.github_pages, premises.home, premises.hardware, external.edge
    include premises.home with { navigateTo home_apps }
    include premises.hardware with { navigateTo placement }
    exclude external.edge.routes.** -> *
    exclude * -> * where kind is not deploy
    autoLayout TopBottom 80 60
  }
  view secrets {
    title '秘密情報の管理・注入'
    description 'BWSと共通ESO・SecretStoreを基盤として提供。利用側のSecret定義やアプリ設定はここでは展開しない。'
    include external.bws, premises.home.eso, external.github, external.terraform_cloud, premises.management.ansible, premises.data.backups
    exclude external.edge.routes.** -> *
    exclude * -> * where kind is not secret
    autoLayout LeftRight 80 60
  }
  view observability {
    title '監視の収集・保存・照会'
    description '共用の自宅監視基盤の収集・保存・照会。Re:Venter専用のOCI監視VM・PDC・データ保存構成はreventer側の図に集約。'
    include operator, external.grafana, premises.hardware, premises.home.agent, premises.home.agent.collector, premises.home.agent.local_store, premises.home.agent.pdc, premises.home.agent.exporters
    exclude external.edge.routes.** -> *
    exclude * -> * where kind is not observe and kind is not query and kind is not connect
    autoLayout LeftRight 80 60
  }
  deployment view placement {
    title '基盤の配置 / 管理範囲'
    include homeSite, homeSite.x570, homeSite.x570.nas1, homeSite.x570.pbs, homeSite.b550m, homeSite.b550m.nas2, homeSite.talos
    exclude * -> *
    autoLayout TopBottom 80 60
  }
  view network {
    title 'ネットワーク / LAN・WARP'
    description 'WARPのprivate CIDR routeと自宅LANのL3接続。公開WebのAccess認証は入口・認証で扱う。Re:VenterのOCI通信経路は利用側の図を参照。'
    include operator, external.edge.warp, premises.lan, premises.lan.*, premises.hardware.router, premises.hardware.wifi, premises.hardware.unifi, premises.hardware.lb, premises.home.dns, premises.home.dns.coredns, premises.home.dns.metallb
    exclude external.edge.routes.** -> *
    exclude * -> * where kind is not network and kind is not connect
    autoLayout LeftRight 80 60
  }
  view storage {
    title '保存・バックアップ / 復元元の区別'
    include premises.home.nextcloud, premises.home.recording, premises.home.agent.local_store, premises.data, premises.data.nas, premises.data.nas.nas01, premises.data.nas.nas02, premises.data.pbs, premises.data.databases, premises.data.databases.*, premises.data.shared, premises.data.backups, premises.data.backups.*, external.idrive, premises.hardware.x570, premises.hardware.b550m
    include premises.data.nas.nas01, premises.data.nas.nas02, premises.data.pbs with { navigateTo placement }
    exclude external.edge.routes.** -> *
    exclude * -> * where kind is not runtime and kind is not backup
    autoLayout LeftRight 80 60
  }
  view power {
    title '電源・安全停止 / UPS・NUTのcross-power'
    include premises.hardware.ups, premises.hardware.ups.*, premises.hardware.x570, premises.hardware.b550m
    exclude external.edge.routes.** -> *
    exclude * -> * where kind is not power and kind is not network and kind is not query
    autoLayout LeftRight 80 60
  }
}
