views {
  style * { size xs
    textSize md
    padding sm }

  view index {
    title 'my-infra'
    include user, edge, home, oke
    group '運用' {
      color gray
      border none
      opacity 4%
      include control, monitoring
    }
    include home with { navigateTo home_apps }
    include edge with { navigateTo home_apps }
    include oke with { navigateTo placement }
    include control with { navigateTo delivery }
    include monitoring with { navigateTo observability }
    global predicate runtimeLinks
    autoLayout LeftRight 80 50
  }

  view home_apps of home {
    title '自宅のサービス'
    group 'ファイル' {
      color gray
      border none
      opacity 4%
      include home.nextcloud, data.nas, data.pbs
    }
    group '映像' {
      color gray
      border none
      opacity 4%
      include home.tnlastation, home.epgstation, home.mirakurun
    }
    group '宅内' {
      color gray
      border none
      opacity 4%
      include home.loockit, home.coupon_manager, home.wol
    }
    include home.tnlastation with { navigateTo media }
    include data.pbs with { navigateTo placement }
    exclude * -> *
    rank same { home.nextcloud, home.tnlastation, home.loockit }
    autoLayout TopBottom 70 50
  }

  view media of home.tnlastation {
    title '録画と配信'
    group '入口' {
      color gray
      border none
      opacity 4%
      include home.tnlastation.gateway, home.tnlastation.frontend
    }
    group '処理' {
      color gray
      border none
      opacity 4%
      include home.tnlastation.backend, home.tnlastation.encoder, home.tnlastation.stream
    }
    group '保存と入力' {
      color gray
      border none
      opacity 4%
      include home.postgres, home.mirakurun, data.recorded
    }
    exclude * -> * where tag is not #runtime and tag is not #storage
    autoLayout LeftRight 80 50
  }

  view delivery of control {
    title '構成の反映'
    group '正本' {
      color gray
      border none
      opacity 4%
      include control.git, control.ci, control.tfc
    }
    group '実行' {
      color gray
      border none
      opacity 4%
      include control.agent, control.argo, control.updater
    }
    group '対象' {
      color gray
      border none
      opacity 4%
      include hardware.x570, hardware.b550m, control.api, oke.api
    }
    include control.ci with { navigateTo secrets }
    include control.agent with { navigateTo secrets }
    include hardware.x570 with { navigateTo placement }
    include hardware.b550m with { navigateTo placement }
    global predicate deliveryLinks
    autoLayout LeftRight 80 50
  }

  view secrets of control.bws {
    title '秘密情報'
    include control.bootstrap, control.bws, control.ci, control.sdk, control.eso, control.secrets, home.tnlastation
    global predicate secretsLinks
    autoLayout LeftRight 80 50
  }

  view observability of monitoring {
    title '監視'
    group '収集' {
      color gray
      border none
      opacity 4%
      include monitoring.vmagent, monitoring.collector
    }
    group '保存' {
      color gray
      border none
      opacity 4%
      include monitoring.homeVM, monitoring.remoteMetrics, monitoring.remoteLogs
    }
    group '参照' {
      color gray
      border none
      opacity 4%
      include monitoring.pdc, monitoring.remotePdc, monitoring.query, monitoring.grafana
    }
    global predicate observabilityLinks
    autoLayout LeftRight 80 50
  }
}
