model {
  actor user '利用者'
  actor operator '管理者 / Ansible / Talos CLI'
  system edge 'Cloudflare DNS / Access / Tunnel'
  store git 'GitHub my-infra / reventer'
  service ci 'GitHub Actions'
  system tfc 'Terraform Cloud'
  store bws 'Bitwarden Secrets Manager'
  system grafana 'Grafana Cloud'
  system pve 'Proxmox VE 2ホスト'
  store nas 'TrueNAS'
  system network 'IX2215 / switch / AP / VLAN'
  system home 'home-k8s / Talos' {
    service argo 'ArgoCD + Image Updater'
    service tunnel 'cloudflared'
    service agent 'Terraform Cloud agent'
    service eso 'ESO + Bitwarden SDK server'
    store secrets 'Kubernetes Secrets'
    service apps 'Nextcloud / 録画・配信 / WoL / その他アプリ'
    service dns 'CoreDNS / MetalLB'
    store metrics 'VictoriaMetrics'
    service scrape 'vmagent / exporters'
    service pdc 'Grafana PDC'
    service runner 'ARC GitHub Actions runners'
  }
  system stg 'STG OCI / OKE' {
    service eso 'ESO + Bitwarden SDK server'
    store secrets 'Kubernetes Secrets'
    service apps 'Re:Venterアプリ / reventer所有'
    service lb 'OCI LB / NGINX Gateway'
    service collect 'vmagent / Fluent Bit'
    service argo '共通基盤用ArgoCD'
    service admin 'STG / PRD管理画面 / reventer所有'
  }
  system prd 'PRD OCI / OKE / reventer所有' {
    service eso 'ESO + Bitwarden SDK server'
    store secrets 'Kubernetes Secrets'
    service apps 'Re:Venterアプリ / reventer所有'
    service lb 'OCI LB / NGINX Gateway'
    service collect 'vmagent / Fluent Bit'
  }
  system monitorstg 'STG OCI監視VM 2台'
  system monitorprd 'PRD OCI監視VM 2台'
  home.eso -[secret]-> bws 'SDK経由取得'
  home.eso -[secret]-> home.secrets '同期'
  home.secrets -[secret]-> home.apps '注入'
  home.argo -[deploy]-> home.apps 'Kubernetes APIへ同期'
  home.argo -[deploy]-> home.eso '共通基盤同期'
  stg.eso -[secret]-> bws 'SDK経由取得'
  stg.eso -[secret]-> stg.secrets '同期'
  stg.secrets -[secret]-> stg.apps '注入'
  home.argo -[deploy]-> stg.apps 'Kubernetes APIへ同期'
  prd.eso -[secret]-> bws 'SDK経由取得'
  prd.eso -[secret]-> prd.secrets '同期'
  prd.secrets -[secret]-> prd.apps '注入'
  home.argo -[deploy]-> prd.apps 'Kubernetes APIへ同期'
  home.argo -[deploy]-> git 'desired state取得'
  stg.argo -[deploy]-> git '共通基盤定義取得'
  stg.argo -[deploy]-> stg.eso '共通基盤同期'
  stg.argo -[deploy]-> prd.eso 'PRD共通基盤同期'
  ci -[deploy]-> tfc 'plan / apply run'
  home.agent -[deploy]-> tfc 'job取得 / 実行結果'
  home.agent -[deploy]-> pve 'Proxmox API / VM作成'
  tfc -[deploy]-> stg 'OCI API / STG作成'
  operator -[deploy]-> monitorstg 'Terraform local / Ansible'
  operator -[deploy]-> monitorprd 'Terraform local / Ansible'
  operator -[deploy]-> network 'Ansible設定'
  operator -[deploy]-> home 'Talos設定 / bootstrap'
  ci -[deploy]-> home.runner 'job配布'
  home.argo -[deploy]-> stg.admin 'STG OKEへ同期'
  operator -[secret]-> bws 'bws CLI / bootstrap'
  home.secrets -[secret]-> home.argo 'GHCR / 通知認証情報'
  home.secrets -[secret]-> home.agent 'agent token'
  home.secrets -[secret]-> home.tunnel 'tunnel token'
  home.secrets -[secret]-> home.runner 'runner認証'
  stg.secrets -[secret]-> stg.admin '環境別注入'
  user -[access]-> edge '公開hostname HTTPS'
  edge -[access]-> home.tunnel 'Access対象は認証後 / Tunnel'
  home.tunnel -[access]-> home.apps '内部serviceへ転送'
  home.tunnel -[access]-> home.argo '管理UI'
  operator -[access]-> edge '管理hostname / Access'
  user -[access]-> network 'LANアクセス'
  network -[access]-> home.dns '内部DNS問い合わせ'
  home.apps -[access]-> nas '録画保存 / NFS'
  edge -[access]-> stg.lb 'Re:Venter STG / Access'
  edge -[access]-> prd.lb 'Re:Venter PRD / 公開'
  stg.lb -[access]-> stg.apps 'HTTPRoute'
  prd.lb -[access]-> prd.apps 'HTTPRoute'
  pve -[placement]-> home 'Talos VM収容 / RPiは別筐体'
  pve -[placement]-> nas 'NAS VM収容'
  home.scrape -[observe]-> pve 'API scrape'
  home.scrape -[observe]-> network 'SNMP / probes'
  home.scrape -[observe]-> nas 'exporter scrape'
  home.scrape -[observe]-> home.metrics 'remote_write'
  grafana -[observe]-> home.pdc 'PDC経由query'
  home.pdc -[observe]-> home.metrics 'query'
  stg.collect -[observe]-> monitorstg 'metrics / logs'
  prd.collect -[observe]-> monitorprd 'metrics / logs'
  grafana -[observe]-> monitorstg 'PDC経由query'
  grafana -[observe]-> monitorprd 'PDC経由query'
}
