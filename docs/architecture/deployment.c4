deployment {
  site homeSite '自宅 / Proxmox2ホスト・RPi' {
    description 'PVE → VM/LXC → Talos OSの物理包含と、home-k8sへの所属を別に表す。PodはVMに固定しない。'
    hypervisor x570 'pve-x570' { description '192.168.0.115 / native1。Talos VM2・TrueNAS・PBS・UniFi・Windows・LXC2。'
      instanceOf premises.hardware.x570
      workload bluez 'BlueZ / USB Bluetooth' { instanceOf premises.hardware.ble_a }
      vm cp1 'Talos controlplane01 / VM13001' { metadata { sourceFile "terraform/home-k8s/main.tf" resourceRef "proxmox_virtual_environment_vm.talos" vmId "13001" vlan "20" } os talos 'Talos OS / VLAN20' { instanceOf premises.home.platform.controlplane } }
      vm worker1 'Talos worker01 / VM13004' { metadata { sourceFile "terraform/home-k8s/main.tf" resourceRef "proxmox_virtual_environment_vm.talos" vmId "13004" vlan "20" } os talos 'Talos OS / VLAN20' { instanceOf premises.home.platform.worker } }
      vm lb 'HAProxy / Keepalived VM10001' { metadata { sourceFile "terraform/pve/main.tf" resourceRef "module.load_balancer" vmId "10001" vlan "20" bridge "vmbr0" } instanceOf premises.hardware.lb }
      vm pbs 'PBS VM14001' { metadata { sourceFile "terraform/pve/main.tf" resourceRef "module.pbs" vmId "14001" vlan "20" bridge "vmbr0" } instanceOf premises.data.pbs }
      vm unifi 'UniFi OS VM13201' { metadata { sourceFile "terraform/pve/main.tf" resourceRef "module.unifi_os_server" vmId "13201" vlan "native1" bridge "vmbr0" } workload app 'Podman / UniFi OS・Network' { instanceOf premises.hardware.unifi } }
      container loockit 'Loockit 01 / CT12902' { metadata { sourceFile "terraform/loockit-lxc/main.tf" resourceRef "proxmox_virtual_environment_container.loockit" vmId "12902" vlan "20" bridge "vmbr0" } workload app 'Docker / Loockit REST・gRPC' { instanceOf premises.hardware.loockit_a } }
      container tuner 'Mirakurun本番 / CT12901・PT3' { metadata { sourceFile "terraform/mirakurun-lxc/main.tf" resourceRef "proxmox_virtual_environment_container.mirakurun" vmId "12901" vlan "20" bridge "vmbr0" } workload app 'Docker / Mirakurun / PT3' { instanceOf premises.hardware.tuner_prod } }
      vm windows 'Windows / VM60000 / tag30' { metadata { sourceFile "docs/architecture/evidence/pve-runtime.json" vmId "60000" vlan "30" managedBy "observed-only" } instanceOf premises.hardware.windows }
      vm nas1 'TrueNAS VM69001 / nas-01' { metadata { sourceFile "terraform/pve/main.tf" resourceRef "module.truenas" vmId "69001" vlan "20" bridge "vmbr0" } instanceOf premises.data.nas.nas01 }
    }
    hypervisor b550m 'pve-b550m' { description '192.168.0.119 / native1。Talos VM3・TrueNAS・Docker開発・表示VM・LXC2。'
      instanceOf premises.hardware.b550m
      workload bluez 'BlueZ / USB Bluetooth' { instanceOf premises.hardware.ble_b }
      vm cp2 'Talos controlplane02 / VM13002' { metadata { sourceFile "terraform/home-k8s/main.tf" resourceRef "proxmox_virtual_environment_vm.talos" vmId "13002" vlan "20" } os talos 'Talos OS / VLAN20' { instanceOf premises.home.platform.controlplane } }
      vm cp3 'Talos controlplane03 / VM13003' { metadata { sourceFile "terraform/home-k8s/main.tf" resourceRef "proxmox_virtual_environment_vm.talos" vmId "13003" vlan "20" } os talos 'Talos OS / VLAN20' { instanceOf premises.home.platform.controlplane } }
      vm worker2 'Talos worker02 / VM13005' { metadata { sourceFile "terraform/home-k8s/main.tf" resourceRef "proxmox_virtual_environment_vm.talos" vmId "13005" vlan "20" } os talos 'Talos OS / VLAN20' { instanceOf premises.home.platform.worker } }
      vm lb 'HAProxy / Keepalived VM10002' { metadata { sourceFile "terraform/pve/main.tf" resourceRef "module.load_balancer" vmId "10002" vlan "20" bridge "vmbr0" } instanceOf premises.hardware.lb }
      vm dev '開発用Docker / VM40000' { metadata { sourceFile "terraform/pve/main.tf" resourceRef "module.dev_application_server" vmId "40000" vlan "20" bridge "vmbr0" } instanceOf premises.hardware.dev }
      vm kiosk 'MagicMirror表示 / VM5000' { metadata { sourceFile "terraform/pve/main.tf" resourceRef "module.displaylink_kiosk" vmId "5000" vlan "40" bridge "vmbr0" } instanceOf premises.hardware.kiosk }
      container loockit 'Loockit 02 / CT12903' { metadata { sourceFile "terraform/loockit-lxc/main.tf" resourceRef "proxmox_virtual_environment_container.loockit" vmId "12903" vlan "20" bridge "vmbr0" } workload app 'Docker / Loockit REST・gRPC' { instanceOf premises.hardware.loockit_b } }
      container tuner 'Mirakurun STG / CT12904・PX-S1UD' { metadata { sourceFile "terraform/mirakurun-staging-lxc/main.tf" resourceRef "proxmox_virtual_environment_container.mirakurun_staging" vmId "12904" vlan "20" bridge "vmbr0" } workload app 'Docker / Mirakurun / PX-S1UD' { instanceOf premises.hardware.tuner_stg } }
      vm nas2 'TrueNAS VM69002 / nas-02' { metadata { sourceFile "terraform/pve/main.tf" resourceRef "module.truenas" vmId "69002" vlan "20" bridge "vmbr0" } instanceOf premises.data.nas.nas02 }
    }
    physical worker_pi1 'RPi / worker03 / VLAN10' { os talos 'Talos OS / arm64' { instanceOf premises.home.platform.worker } }
    physical worker_pi2 'RPi / worker04 / VLAN10' { os talos 'Talos OS / arm64' { instanceOf premises.home.platform.worker } }
    physical nut_pi1 'NUT Pi / .112' { instanceOf premises.hardware.ups.pi_a }
    physical nut_pi2 'NUT Pi / .113' { instanceOf premises.hardware.ups.pi_b }
    physical ups_a 'UPS A' { instanceOf premises.hardware.ups.ups_a }
    physical ups_b 'UPS B' { instanceOf premises.hardware.ups.ups_b }
    instanceOf premises.lan
    physical network 'ネットワーク機器 / IX2215・SW・AP' { instanceOf premises.hardware.network }
    instanceOf premises.hardware.kvm
    cluster talos 'home-k8s' {
      description '3 CP VM・2 worker VM・2 RPiで構成。namespace/Podの配置は動的。'
      instanceOf premises.home

    }
  }
  homeSite.x570.cp1.talos .member homeSite.talos 'control-plane / home-k8s所属'
  homeSite.x570.worker1.talos .member homeSite.talos 'worker / home-k8s所属'
  homeSite.b550m.cp2.talos .member homeSite.talos 'control-plane / home-k8s所属'
  homeSite.b550m.cp3.talos .member homeSite.talos 'control-plane / home-k8s所属'
  homeSite.b550m.worker2.talos .member homeSite.talos 'worker / home-k8s所属'
  homeSite.worker_pi1.talos .member homeSite.talos 'worker / home-k8s所属'
  homeSite.worker_pi2.talos .member homeSite.talos 'worker / home-k8s所属'
  cluster stg 'Re:Venter / STG OCI・OKE（参照のみ）' {
    instanceOf consumers.reventer

  }
  cluster prd 'Re:Venter専用PRD / 定義の対応付けのみ' {
    description '専用構成はreventer側の図に集約。この配置はソース定義との対応付けだけに用い、my-infraの配置ビューでは展開しない。'
    instanceOf consumers.reventer
  }

  homeSite.x570.nas1 .network homeSite.lan.server "vmbr0 / tag 20"
  homeSite.x570.pbs .network homeSite.lan.server "vmbr0 / tag 20"
  homeSite.x570.cp1 .network homeSite.lan.server "vmbr0 / tag 20"
  homeSite.x570.lb .network homeSite.lan.server "vmbr0 / tag 20"
  homeSite.x570.unifi .network homeSite.lan.native "vmbr0 / native 1"
  homeSite.x570.worker1 .network homeSite.lan.server "vmbr0 / tag 20"
  homeSite.x570.windows .network homeSite.lan.client "vmbr0 / tag 30"
  homeSite.x570.loockit .network homeSite.lan.server "vmbr0 / tag 20"
  homeSite.x570.tuner .network homeSite.lan.server "vmbr0 / tag 20"
  homeSite.b550m.kiosk .network homeSite.lan.iot "vmbr0 / tag 40"
  homeSite.b550m.worker2 .network homeSite.lan.server "vmbr0 / tag 20"
  homeSite.b550m.dev .network homeSite.lan.server "vmbr0 / tag 20"
  homeSite.b550m.cp3 .network homeSite.lan.server "vmbr0 / tag 20"
  homeSite.b550m.lb .network homeSite.lan.server "vmbr0 / tag 20"
  homeSite.b550m.cp2 .network homeSite.lan.server "vmbr0 / tag 20"
  homeSite.b550m.nas2 .network homeSite.lan.server "vmbr0 / tag 20"
  homeSite.b550m.loockit .network homeSite.lan.server "vmbr0 / tag 20"
  homeSite.b550m.tuner .network homeSite.lan.server "vmbr0 / tag 20"
}
