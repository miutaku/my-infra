specification {
  element actor { style { shape person
    color green } }
  element system { style { color gray } }
  element service
  element store { style { shape storage
    color amber } }
  relationship access { color blue
    line solid }
  relationship deploy { color amber
    line dashed }
  relationship secret { color red
    line dotted }
  relationship observe { color green
    line dotted }
  relationship placement { color gray
    line dashed }
}
