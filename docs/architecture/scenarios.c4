views {
  dynamic view gitops_release {
    title '08 処理順 / Git更新からhome同期'
    description '変更の正本とpull型同期。手順としての順序を動的ビューで表す。'
    variant sequence
    operator -> control.git '構成commit'
    control.argo -> control.git 'desired state取得'
    control.argo -> control.api 'Application同期'
    control.registry -> home.tnlastation 'image取得'
  }

  dynamic view secret_sync {
    title '08 処理順 / BWSからhome Podへ'
    description '08 処理順 / BWSからhome Podへ'
    variant sequence
    control.eso -> control.sdk 'TLS request'
    control.sdk -> control.bws 'project secret取得'
    control.sdk -> control.eso '取得結果'
    control.eso -> control.secrets '同期'
    control.secrets -> home.tnlastation '注入'
  }

  dynamic view record_encode {
    title '08 処理順 / 録画とSQL queue'
    description '08 処理順 / 録画とSQL queue'
    variant sequence
    home.tnlastation.backend -> home.mirakurun '録画入力取得'
    home.tnlastation.backend -> data.recorded 'TS保存'
    home.tnlastation.backend -> home.postgres 'encode job登録'
    home.tnlastation.encoder -> home.postgres 'atomic claim / lease更新'
    home.tnlastation.encoder -> data.recorded 'encode結果保存'
    home.tnlastation.encoder -> home.postgres '完了記録'
  }
}
