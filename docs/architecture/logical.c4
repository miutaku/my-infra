model {
  system premises '自宅' {
    system home 'home-k8s（Talos Linux）' {
      description 'Kubernetesクラスタ。Talos Linuxのcontrol-plane VM3台、worker VM2台とRaspberry Pi worker2台で構成。'
      link https://github.com/miutaku/my-infra/tree/main/talos/home-k8s 'Talos定義'
      component nextcloud 'Nextcloud' { description 'ファイル共有 / app-nextcloud。MariaDB・Redisとnas-02のNFSを使用。' link https://github.com/miutaku/my-infra/tree/main/k8s/pve/nextcloud '定義' }
      component recording '録画・配信 / EPGStation・TNLaStation' { description 'EPGStation・TNLaStation・Mirakurun。チューナーLXCとKubernetesのアプリは別の実行基盤。' link https://github.com/miutaku/my-infra/tree/main/k8s/pve/tnlastation '定義' }
      component apps '生活サービス / Loockit・Coupon・WOL'  { description 'Loockit・Coupon Manager・Wake-on-LAN・Annict連携など。全Applicationとリソースは自動抽出一覧から確認できる。' link https://github.com/miutaku/my-infra/tree/main/k8s/pve/argocd-apps 'Application一覧' }
      component dns '内部DNS / MetalLB' { description 'miutaku.internalはCoreDNS。MetalLBでLAN内Service IPを払い出す。' link https://github.com/miutaku/my-infra/tree/main/k8s/pve/coredns '定義' }
      component eso 'External Secrets Operator' { description 'ClusterSecretStoreを通してBWSからSecretを注入する。秘密値は図・生成一覧へ含めない。' link https://github.com/miutaku/my-infra/tree/main/k8s/pve/external-secrets '定義' }
      component agent '自宅監視基盤' { description 'vmagent・exporter・自宅VictoriaMetrics・PDC agent。OCI監視VMとは独立。' link https://github.com/miutaku/my-infra/tree/main/k8s/pve/vmagent '定義' }
    }
    system hardware '物理・ネットワーク' {
      component network 'ネットワーク機器' { description 'IX2215・US-8-60W・FS AP。機器を開くとEthernet・VLAN・PVEのトランクを確認できる。' }
      component ups 'UPS / NUT' { description '電源断を検知してVM・NAS・物理ホストを順序制御する。RPi workerとは別のNUT機器を利用。' link https://github.com/miutaku/my-infra/blob/main/docs/ups-shutdown.md '手順' }
    }
    system pve 'Proxmox VEクラスタ' {
      component x570 'pve-x570 / Proxmox' { description '192.168.0.115。home-k8s VM2台・TrueNAS・PBS・UniFi・Loockit/Mirakurunなどを実行。' }
      component b550m 'pve-b550m / Proxmox' { description '192.168.0.119。home-k8s VM3台・TrueNAS・開発VM・kiosk・Loockit/Mirakurunを実行。' }
      store nas01 'nas-01 / TrueNAS VM69001' { description 'pve-x570。192.168.20.191。runner cache用NFS。USB disk passthrough上のZFS。' link https://github.com/miutaku/my-infra/blob/main/ansible/truenas/host_vars/nas-01.yml 'dataset定義' }
      store nas02 'nas-02 / TrueNAS VM69002' { description 'pve-b550m。192.168.20.192。録画・Nextcloud・DB・監視のNFS。USB disk passthrough上のZFS。' link https://github.com/miutaku/my-infra/blob/main/ansible/truenas/host_vars/nas-02.yml 'dataset定義' }
      store pbs 'PBS / VM14001' { description 'pve-x570。VMバックアップをIDrive e2のS3互換datastoreへ保存。' link https://github.com/miutaku/my-infra/tree/main/ansible/pbs '定義' }
    }
  }
  extend premises {
    system management '自宅基盤の構成管理' {

      component ansible 'Ansible' { description 'IX2215・NAS・VM・LXC・UPSなどを構成する。' link https://github.com/miutaku/my-infra/tree/main/ansible 'Playbooks' }
    }
  }
  extend premises.home { component management 'クラスタ運用' {
      component tfc_agents 'Terraform Cloud agents / 自宅' { description '共用・my-infra向けworkspaceを実行するagent。Re:Venter専用agentは利用側の境界へ分ける。' }
      component argo '自宅ArgoCD' { description 'home-k8sとRe:Venter STG・PRDを同期する。自宅停止時は同期が止まるがOKEの実行・スケールは継続する。' link https://github.com/miutaku/my-infra/tree/main/k8s/pve/argocd-apps 'Application定義' }
      component runner 'ARC / 共用のrunner制御基盤' { description '共用Controllerとmy-infra向け実行環境。Re:Venter専用scale setは利用側の境界へ分ける。' link https://github.com/miutaku/my-infra/tree/main/k8s/pve/argocd-apps '定義' }
  } }
  extend external {
    system edge 'Cloudflare' {
      description 'Cloudflare Accessで認証し、Tunnelで自宅サービスへ転送。mTLS APIとWARPも提供。'
      link https://github.com/miutaku/my-infra/tree/main/terraform/cloudflare '定義'
      component tunnel 'Cloudflare Tunnel' { description '自宅基盤のcloudflaredが外向き接続を確立。公開hostnameのHTTPを内部Serviceへ転送する。' }
      component access 'Cloudflare Access / 共通の認証入口' { description '利用・管理の公開UIを原則Accessで保護。mTLS専用API、WARPのprivate CIDR routeとは区別する。' }
    }
    system bws 'Bitwarden Secrets Manager' { description 'Terraform・GitHub Actions・External Secretsへ秘密情報を配布。' link https://github.com/miutaku/my-infra/tree/main/k8s/pve/external-secrets 'SecretStore定義' }
    component grafana 'Grafana Cloud / PDC' { description 'PDC agentが外向き接続を作り、Grafanaからprivate監視データを照会する。ここでは自宅VictoriaMetricsの照会経路を示す。Re:Venter専用の監視構成は利用側の図で管理。' }
    component github 'GitHub / コード・Actions' { description 'Terraform・Ansible・Kubernetes定義。Actionsは検証・imageビルド・モデル更新を実行。' link https://github.com/miutaku/my-infra/tree/main/.github/workflows 'Workflows' }
    component terraform_cloud 'Terraform Cloud' { description 'my-infraのworkspaceで自宅基盤のplan/applyを実行する。Re:Venter向けの変更経路は利用側の図で管理。' }
  }
  actor user '利用者'
  actor operator '管理者'


  system consumers '基盤の利用側 / 別リポジトリ' {
    system reventer 'Re:Venter' { description '基盤を利用するワークロードの一つ。OCI/OKE・監視VM・GitOps/CI/Terraformによる変更経路・専用runner/agent・レビュー配信を含む専用構成はこの境界に集約。my-infraには共有基盤との接点と定義元の参照だけを残し、構成・通信の詳細はreventer側の図へ委ねる。' link https://github.com/miutaku/reventer '利用側の構成' link https://reventer-architecture.pages.dev/ '利用側の構成図' }
  }



  user .runtime external.edge.access 'HTTPS / 利用時の認証'
  operator .admin external.edge.access 'HTTPS / 管理時の認証'
  external.edge.access .authenticate external.edge.tunnel 'Access認証後の転送'
  premises.hardware.network.router .runtime premises.home.dns 'LAN / 内部DNS'
  external.github .deploy premises.home.management.argo 'GitOps'
  external.github .deploy external.terraform_cloud 'Terraform実行'
  external.github .deploy premises.home.management.runner 'Actions job'
  premises.home.management.argo .provide consumers.reventer '共用ArgoCDの同期インターフェース'
  external.terraform_cloud .deploy premises.home.management.tfc_agents 'workspace runを自宅agentで実行'
  premises.home.management.tfc_agents .deploy premises.pve 'VM / ネットワーク'
  external.terraform_cloud .deploy external.edge 'DNS / Access / Tunnel'
  premises.pve.nas02 .provide premises.home 'アプリ・DB・監視のNFS'
  premises.pve.nas01 .provide premises.home.management.runner 'runner cache / NFS'
  premises.home.management.runner .provide consumers.reventer '専用runner向けの共用制御基盤'
  premises.management.ansible .deploy premises.hardware 'NW・UPS機器設定'
  premises.management.ansible .deploy premises.pve 'VM・NAS・LXC設定'
  external.bws .secret premises.home.eso 'Secret注入'
  external.bws .secret external.github 'CI credential'
  external.bws .secret external.terraform_cloud 'Terraform変数'
  premises.hardware .observe premises.home.agent.collector 'exporter収集'
  operator .query external.grafana '照会'
  premises.pve.x570 .backup premises.pve.pbs 'VM backup'
  premises.pve.b550m .backup premises.pve.pbs 'VM backup'
}
