model {
  system premises '自宅' {
    system home 'Talos / home-k8s' {
      description 'Talos。CP VM3台・worker VM2台をProxmox2ホストへ配置し、RPi worker2台を追加。Podの配置は動的。'
      link https://github.com/miutaku/my-infra/tree/main/talos/home-k8s 'Talos定義'
      component nextcloud 'Nextcloud' { link https://github.com/miutaku/my-infra/tree/main/k8s/pve/nextcloud '定義' }
      component recording '録画・配信' { description 'EPGStation・TNLaStation・Mirakurun。チューナーLXCとKubernetesのアプリは別の実行基盤。' link https://github.com/miutaku/my-infra/tree/main/k8s/pve/tnlastation '定義' }
      component apps '自宅ワークロード / 基盤の利用側' { description 'Loockit・Coupon Manager・Wake-on-LAN・Annict連携など。全Applicationとリソースは自動抽出一覧から確認できる。' link https://github.com/miutaku/my-infra/tree/main/k8s/pve/argocd-apps 'Application一覧' }
      component dns '内部DNS / MetalLB' { description 'miutaku.internalはCoreDNS。MetalLBでLAN内Service IPを払い出す。' link https://github.com/miutaku/my-infra/tree/main/k8s/pve/coredns '定義' }
      component eso 'External Secrets Operator' { description 'ClusterSecretStoreを通してBWSからSecretを注入する。秘密値は図・生成一覧へ含めない。' link https://github.com/miutaku/my-infra/tree/main/k8s/pve/external-secrets '定義' }
      component agent '自宅監視基盤' { description 'vmagent・exporter・自宅VictoriaMetrics・PDC agent。OCI監視VMとは独立。' link https://github.com/miutaku/my-infra/tree/main/k8s/pve/vmagent '定義' }
    }
    system hardware '物理・ネットワーク' {
      component x570 'Proxmox / x570'
      component b550m 'Proxmox / b550m'
      component router 'IX2215 / VLAN' { description 'native・管理・server・client・guest・IoTを分離。guest VLANから他VLANは到達不可。' link https://github.com/miutaku/my-infra/tree/main/ansible/ix2215 '定義' }
      component ups 'UPS / NUT' { description '電源断を検知してVM・NAS・物理ホストを順序制御する。RPi workerとは別のNUT機器を利用。' link https://github.com/miutaku/my-infra/blob/main/docs/ups-shutdown.md '手順' }
    }
    system data '保存・バックアップ' {
      store nas 'TrueNAS VM ×2 / ZFS・NFS' { description '自宅Proxmoxの各ホストに1台ずつ、VM69001・69002。USB diskをpassthrough。Kubernetes PVCやメディアを保存。マウント・データセットとNFS share、VMバックアップを区別する。' link https://github.com/miutaku/my-infra/tree/main/ansible/truenas '定義' }
      store pbs 'Proxmox Backup Server' { description 'VMバックアップ。NFSのオンライン利用経路とは別。' link https://github.com/miutaku/my-infra/tree/main/ansible/pbs '定義' }
    }
  }
  extend external {
    system edge 'Cloudflare' {
      description '自宅サービスの公開入口は原則Accessで認証してTunnelへ転送。mTLS専用APIとWARP/LAN経路は別に示す。'
      link https://github.com/miutaku/my-infra/tree/main/terraform/cloudflare '定義'
      component tunnel 'Cloudflare Tunnel' { description '自宅とSTG OKEのcloudflaredが外向き接続を確立。公開hostnameのHTTPを内部Serviceへ転送する。' }
      component access 'Cloudflare Access / 共通の認証入口' { description '利用・管理の公開UIを原則Accessで保護。mTLS専用API、WARPのprivate CIDR routeとは区別する。' }
    }
    system bws 'Bitwarden Secrets Manager' { description 'BWS。Terraform・CI・External Secretsから利用する秘密情報の管理先。参照元の定義だけを図示し、秘密値は保持しない。' link https://github.com/miutaku/my-infra/tree/main/k8s/pve/external-secrets 'SecretStore定義' }
    component grafana 'Grafana Cloud / PDC' { description 'PDC agentが外向き接続を作り、Grafanaからprivate監視データを照会する。保存先は自宅VictoriaMetricsとOCI監視VM。' }
    component github 'GitHub / コード・Actions' { description 'Terraform・Ansible・Kubernetes定義。Actionsは検証・imageビルド・モデル更新を実行。' link https://github.com/miutaku/my-infra/tree/main/.github/workflows 'Workflows' }
    component terraform_cloud 'Terraform Cloud' { description 'workspaceごとにplan/apply。Proxmox・Talos・OCI・Cloudflareを管理する。' }
  }
  actor user '利用者'
  actor operator '管理者'

  system oke 'OCI / STG OKE共通基盤' {
    description '東京リージョン。base workerとburst workerを使用し、AutoscalerはOKE内で動く。Re:VenterアプリとPRD OKE本体はreventerが所有。'
    link https://github.com/miutaku/my-infra/tree/main/terraform/oci '共通基盤定義'
    component argo 'OKE ArgoCD' { description 'STG OKE共通インフラを同期。Re:Venterアプリは自宅ArgoCDが同期。' link https://github.com/miutaku/my-infra/tree/main/k8s/oci/argocd '定義' }
    component api 'OKE API / Node pools'
    component scale 'Cluster Autoscaler' { description 'burst poolを需要で増減。自宅Talos停止に依存しない。' }
    component eso 'External Secrets Operator'
  }
  system consumers '基盤の利用側 / 別リポジトリ' {
    system reventer 'Re:Venter' { description '基盤を利用するワークロードの一つ。アプリ内部・PRDクラスタ本体・アプリ固有のGateway/HTTPRouteはreventerで管理する。' link https://github.com/miutaku/reventer '利用側の構成' link https://reventer-architecture.pages.dev/ '利用側の構成図' }
  }
  system shared_prd 'PRDクラスタへ提供する共通アドオン' {
    description '外部所有クラスタに提供するControllerと共通設定。クラスタ本体や利用側のアプリ構成をmy-infraの所有として扱わない。'
    link https://github.com/miutaku/my-infra/tree/main/k8s/oci-prd '提供するアドオン'
    component services '共通Application'
    component eso 'External Secrets Operator'
    component gateway 'Gateway Controller / NGINX'
    component certificates 'cert-manager / ClusterIssuer' { description 'Controller・Issuerを提供。証明書の要求は利用側の責務。設置と実際の発行は区別する。' }
  }
  system control '変更・運用' {
    component tfc_agents 'Terraform Cloud agents / 自宅' { description 'クラウドのworkspaceから処理を受け取る自宅のagent。Terraform Cloudサービスとは配置を分ける。' }

    component argo '自宅ArgoCD' { description 'home-k8sとRe:Venter STG・PRDを同期する。自宅停止時は同期が止まるがOKEの実行・スケールは継続する。' link https://github.com/miutaku/my-infra/tree/main/k8s/pve/argocd-apps 'Application定義' }
    component ansible 'Ansible' { description 'IX2215・NAS・VM・LXC・UPSなどを構成する。' link https://github.com/miutaku/my-infra/tree/main/ansible 'Playbooks' }
    component runner 'ARC / 専用runner' { description '実行目的ごとにrunnerを分離。構成モデルAIはPlusログイン専用Pod、公開・比較のビルドはGitHub-hosted runner。' link https://github.com/miutaku/my-infra/tree/main/k8s/pve/argocd-apps '定義' }
  }

  system monitoring '監視' {
    store vms 'OCI監視VM / STG・PRD' { description 'OKEから独立したVM2台／環境へVictoriaMetrics・VictoriaLogsを配置。STG/PRDの定義ディレクトリとアカウントは分離。' link https://github.com/miutaku/my-infra/tree/main/terraform/oci-observability-stg 'STG定義' link https://github.com/miutaku/my-infra/tree/main/terraform/oci-observability 'PRD定義' }

  }
  user .runtime external.edge.access 'HTTPS / 利用時の認証'
  operator .admin external.edge.access 'HTTPS / 管理時の認証'
  external.edge.access .authenticate external.edge.tunnel 'Access認証後の転送'
  external.edge.tunnel .runtime premises.home.nextcloud 'Access認証後 / 公開UI・サービス'
  external.edge.tunnel .runtime premises.home.apps 'Access認証後 / 公開UI・サービス'
  external.edge.tunnel .runtime premises.home.recording 'Access認証後 / 公開UI・サービス'
  external.edge.tunnel .admin control.argo 'Access認証後 / 管理UI'
  external.edge.tunnel .admin premises.hardware 'Access認証後 / 機器管理UI'
  external.edge.tunnel .admin premises.data.nas 'Access認証後 / NAS管理UI'
  premises.hardware.router .runtime premises.home.dns 'LAN / 内部DNS'
  external.github .deploy control.argo 'GitOps'
  external.github .deploy oke.argo 'GitOps'
  external.github .deploy external.terraform_cloud 'Terraform実行'
  external.github .deploy control.runner 'Actions job'
  control.argo .deploy premises.home 'manifest同期'
  control.argo .deploy consumers.reventer 'STG・PRDアプリ同期'
  oke.argo .deploy oke.api '共通基盤同期'
  oke.scale .deploy oke.api 'burst pool増減'
  external.terraform_cloud .deploy control.tfc_agents 'workspace runを自宅agentで実行'
  control.tfc_agents .deploy premises.hardware 'VM / ネットワーク'
  external.terraform_cloud .deploy oke 'OCI / OKE'
  external.terraform_cloud .deploy external.edge 'DNS / Access / Tunnel'
  external.terraform_cloud .deploy monitoring.vms '監視VM'
  control .provide consumers.reventer 'GitOps・CI・Terraformの実行基盤を提供'
  monitoring.vms .provide consumers.reventer '監視データの保存先を提供'
  premises.data.nas .provide premises.home 'NFSストレージを提供'
  control.runner .deploy consumers.reventer '利用側のCI jobを実行'
  control.tfc_agents .deploy consumers.reventer '利用側workspaceの実行を受託'
  control.ansible .deploy premises.hardware '機器設定'
  external.bws .secret premises.home.eso 'Secret注入'
  external.bws .secret oke.eso 'Secret注入'
  external.bws .secret external.github 'CI credential'
  external.bws .secret external.terraform_cloud 'Terraform変数'
  premises.hardware .observe premises.home.agent.collector 'exporter収集'
  operator .query external.grafana '照会'
  external.grafana .query monitoring.vms 'PDC経由'
  premises.hardware.x570 .backup premises.data.pbs 'VM backup'
  premises.hardware.b550m .backup premises.data.pbs 'VM backup'
}
