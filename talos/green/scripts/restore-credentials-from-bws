#!/usr/bin/env bash
set -euo pipefail
umask 077

prefix="TALOS_GREEN_RECOVERY"
output_dir="${1:-./talos-green-recovery}"
tmpdir="$(mktemp -d /tmp/talos-green-restore.XXXXXX)"
trap 'rm -rf -- "${tmpdir}"' EXIT

secret_value() {
  key="$1"
  bws secret list -o json | jq -er --arg key "${key}" '.[] | select(.key == $key) | .value'
}

manifest="$(secret_value "${prefix}_MANIFEST")"
chunks="$(jq -er '.chunks' <<<"${manifest}")"
expected_sha256="$(jq -er '.sha256' <<<"${manifest}")"

: > "${tmpdir}/credentials.b64"
for ((index = 1; index <= chunks; index++)); do
  key="$(printf '%s_%02d' "${prefix}" "${index}")"
  secret_value "${key}" >> "${tmpdir}/credentials.b64"
done

base64 -d "${tmpdir}/credentials.b64" > "${tmpdir}/credentials.tar.gz"
actual_sha256="$(sha256sum "${tmpdir}/credentials.tar.gz" | awk '{print $1}')"
[[ "${actual_sha256}" == "${expected_sha256}" ]] || {
  echo "checksum mismatch" >&2
  exit 1
}

mkdir -p "${output_dir}"
tar -C "${output_dir}" -xzf "${tmpdir}/credentials.tar.gz"
chmod -R go-rwx "${output_dir}"
echo "restored ${chunks} chunks to ${output_dir}; sha256=${actual_sha256}"
