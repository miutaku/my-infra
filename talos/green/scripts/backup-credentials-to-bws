#!/usr/bin/env bash
set -euo pipefail
umask 077

green_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
generated_dir="${green_dir}/.generated"
project_id="${TALOS_BWS_PROJECT_ID:-ddca6f59-7be5-4e9a-ad28-b43a007dce9e}"
prefix="TALOS_GREEN_RECOVERY"
files=(
  controlplane.yaml
  worker.yaml
  worker-rpi4-03.yaml
  worker-rpi4-04.yaml
  talosconfig
  kubeconfig
)

for file in "${files[@]}"; do
  [[ -f "${generated_dir}/${file}" ]] || {
    echo "missing ${generated_dir}/${file}" >&2
    exit 1
  }
done

tmpdir="$(mktemp -d /tmp/talos-green-bws.XXXXXX)"
trap 'rm -rf -- "${tmpdir}"' EXIT

tar -C "${generated_dir}" -czf "${tmpdir}/credentials.tar.gz" "${files[@]}"
sha256="$(sha256sum "${tmpdir}/credentials.tar.gz" | awk '{print $1}')"
base64 -w0 "${tmpdir}/credentials.tar.gz" > "${tmpdir}/credentials.b64"
split -b 7000 -d -a 2 "${tmpdir}/credentials.b64" "${tmpdir}/chunk-"

upsert() {
  key="$1"
  value="$2"
  existing_id="$(bws secret list -o json | jq -r --arg key "${key}" '.[] | select(.key == $key) | .id' | head -n1)"
  if [[ -n "${existing_id}" ]]; then
    bws secret edit "${existing_id}" --value "${value}" -o none
  else
    bws secret create "${key}" "${value}" "${project_id}" -o none
  fi
}

chunk_count=0
for chunk in "${tmpdir}"/chunk-*; do
  chunk_count=$((chunk_count + 1))
  key="$(printf '%s_%02d' "${prefix}" "${chunk_count}")"
  upsert "${key}" "$(<"${chunk}")"
done

manifest="$(jq -nc \
  --arg created "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  --arg sha256 "${sha256}" \
  --argjson chunks "${chunk_count}" \
  '{version:1,created_utc:$created,encoding:"tar+gzip+base64",sha256:$sha256,chunks:$chunks}')"
upsert "${prefix}_MANIFEST" "${manifest}"

echo "stored ${chunk_count} chunks; sha256=${sha256}"
