#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
poc_dir="$(cd -- "${script_dir}/.." && pwd)"
kubeconfig="${KUBECONFIG:-${poc_dir}/.generated/kubeconfig}"
poc_context="${TALOS_POC_KUBE_CONTEXT:-admin@talos-green-poc}"
expected_server="${TALOS_POC_KUBE_SERVER:-https://192.168.20.137:6443}"
chart_version="${TALOS_POC_ESO_CHART_VERSION:-0.14.3}"
actual_server="$(KUBECONFIG="${kubeconfig}" kubectl --context "${poc_context}" config view --minify -o jsonpath='{.clusters[0].cluster.server}')"

if [[ "${actual_server}" != "${expected_server}" ]]; then
  echo "refusing to modify cluster ${actual_server:-<none>}; expected ${expected_server}" >&2
  exit 1
fi

KUBECONFIG="${kubeconfig}" helm upgrade --install external-secrets external-secrets \
  --repo https://charts.external-secrets.io \
  --version "${chart_version}" \
  --namespace external-secrets \
  --create-namespace \
  --values "${poc_dir}/kubernetes/external-secrets/values.yaml" \
  --wait --timeout 5m
KUBECONFIG="${kubeconfig}" kubectl --context "${poc_context}" apply \
  -f "${poc_dir}/kubernetes/external-secrets/test.yaml"

for attempt in $(seq 1 60); do
  ready="$(KUBECONFIG="${kubeconfig}" kubectl --context "${poc_context}" -n talos-poc-secret-target \
    get externalsecret talos-poc -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null || true)"
  if [[ "${ready}" == True ]]; then
    break
  fi
  sleep 3
done
if [[ "${ready:-}" != True ]]; then
  echo "ExternalSecret did not become Ready" >&2
  exit 1
fi

marker="$(KUBECONFIG="${kubeconfig}" kubectl --context "${poc_context}" -n talos-poc-secret-target \
  get secret talos-poc-synced -o jsonpath='{.data.marker}' | base64 -d)"
if [[ "${marker}" != talos-poc-external-secret-only ]]; then
  echo "synced test marker did not match" >&2
  exit 1
fi

KUBECONFIG="${kubeconfig}" kubectl --context "${poc_context}" delete \
  namespace talos-poc-secret-source talos-poc-secret-target --wait=true
echo "External Secrets test passed: isolated source marker synced; test namespaces deleted"
