#!/usr/bin/env bash
set -euo pipefail

cluster_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
kubeconfig="${KUBECONFIG:-${cluster_dir}/.generated/kubeconfig}"
context="${HOME_K8S_KUBE_CONTEXT:-home-k8s}"
expected_server="https://192.168.20.228:6443"
actual_server="$(KUBECONFIG="${kubeconfig}" kubectl --context "${context}" config view --minify -o jsonpath='{.clusters[0].cluster.server}')"
[[ "${actual_server}" == "${expected_server}" ]] || {
  echo "refusing cluster ${actual_server:-<none>}; expected ${expected_server}" >&2; exit 1;
}

label_by_ip() {
  local ip="$1" pve_node="$2" role="$3" hostname_compat="${4:-}" node
  node="$(KUBECONFIG="${kubeconfig}" kubectl --context "${context}" get nodes -o json |
    jq -er --arg ip "${ip}" '.items[] | select(any(.status.addresses[]; .type=="InternalIP" and .address==$ip)) | .metadata.name')"
  KUBECONFIG="${kubeconfig}" kubectl --context "${context}" label node "${node}" --overwrite \
    "topology.miutaku/proxmox-node=${pve_node}" \
    "node.miutaku/role=${role}" \
    "node.miutaku/platform=pve" \
    "network.miutaku/l2=vlan20"
  if [[ -n "${hostname_compat}" ]]; then
    # local-path PV nodeAffinity is immutable; preserve only the historical
    # hostname label while keeping the Kubernetes Node object correctly named.
    KUBECONFIG="${kubeconfig}" kubectl --context "${context}" label node "${node}" --overwrite \
      "kubernetes.io/hostname=${hostname_compat}"
  fi
}

label_rpi_by_ip() {
  local ip="$1" memory="$2" node
  node="$(KUBECONFIG="${kubeconfig}" kubectl --context "${context}" get nodes -o json |
    jq -er --arg ip "${ip}" '.items[] | select(any(.status.addresses[]; .type=="InternalIP" and .address==$ip)) | .metadata.name')"
  KUBECONFIG="${kubeconfig}" kubectl --context "${context}" label node "${node}" --overwrite \
    "node.miutaku/role=agent" \
    "node.miutaku/platform=rpi" \
    "network.miutaku/l2=vlan10" \
    "hardware.miutaku/model=raspberry-pi-4b" \
    "hardware.miutaku/memory=${memory}"
  KUBECONFIG="${kubeconfig}" kubectl --context "${context}" taint node "${node}" --overwrite \
    "workload.miutaku/arm64=reviewed:NoSchedule"
}

label_by_ip 192.168.20.137 pve-x570 controlplane
label_by_ip 192.168.20.138 pve-b550m controlplane
label_by_ip 192.168.20.139 pve-b550m controlplane
label_by_ip 192.168.20.140 pve-x570 agent talos-ayb-pmi
label_by_ip 192.168.20.141 pve-b550m agent
label_rpi_by_ip 192.168.10.107 2gb
label_rpi_by_ip 192.168.10.109 4gb
