{{/* Grafana notification templates; tmpl.Exec reuses the per-alert renderer. */}}
{{ define "my-infra.severity" -}}
{{- $s := toLower .Labels.severity -}}
{{- if eq $s "critical" }}CRITICAL{{ else if or (eq $s "warn") (eq $s "warning") }}WARNING{{ else if eq $s "info" }}INFO{{ else if $s }}{{ printf "%.20s" (toUpper $s) }}{{ else }}UNKNOWN{{ end -}}
{{- end }}

{{ define "my-infra.state" -}}
{{- if eq .Status "resolved" }}🟢 RESOLVED{{ else }}{{ if eq (toLower .Labels.severity) "critical" }}🔴{{ else if eq (toLower .Labels.severity) "info" }}🔵{{ else }}🟠{{ end }} FIRING{{ end -}}
{{- end }}

{{/* Strip Markdown control characters and newlines from human supplied names. */}}
{{ define "my-infra.name" -}}
{{- $name := or .Labels.alertname .Annotations.summary "Alert" -}}
{{- printf "%.100s" (reReplaceAll "[\\r\\n*_`<>@\\[\\]]" " " $name) -}}
{{- end }}

{{ define "my-infra.title" -}}
{{- if eq .Status "resolved" }}🟢 RESOLVED{{ else }}{{ if eq .CommonLabels.severity "critical" }}🔴{{ else if eq .CommonLabels.severity "info" }}🔵{{ else }}🟠{{ end }} FIRING{{ end }} |{{ with .CommonLabels.severity }} {{ if eq . "warn" }}WARNING{{ else }}{{ printf "%.20s" (toUpper .) }}{{ end }} |{{ end }} {{ len .Alerts.Firing }} firing / {{ len .Alerts.Resolved }} resolved
{{- with .CommonLabels.alertname }} | {{ printf "%.100s" (reReplaceAll "[\\r\\n*_`<>@\\[\\]]" " " .) }}{{ end -}}
{{- end }}

{{ define "my-infra.context" -}}
{{- $l := .Labels -}}
{{- $place := "" -}}
{{- range $l.SortedPairs -}}
  {{- if and .Value (match "^(environment|cluster|region|site|datacenter|zone)$" .Name) -}}
    {{- $place = printf "%s%s=%s " $place .Name .Value -}}
  {{- end -}}
{{- end -}}
{{- if $place }}環境: {{ printf "%.120s" (reReplaceAll "[\\r\\n*_`<>@\\[\\]]" " " $place) }}{{ "\n" }}{{ end -}}
{{- $target := "" -}}
{{- range $l.SortedPairs -}}
  {{- if and .Value (match "^(service|target|namespace|node|pod|deployment|statefulset|daemonset|container|persistentvolumeclaim|persistentvolume|cronjob|job_name|owner_name|tuner|pool|zpool|device|mountpoint|hrStorageDescr|ifDescr|ifIndex|ups|name|id|vm|vmid|backup|repository|port|service_id|scale_set|vip|condition|flag|datasource_uid|ref_id)$" .Name) -}}
    {{- $target = printf "%s%s=%s " $target .Name .Value -}}
  {{- end -}}
{{- end -}}
{{/* instance often identifies the exporter, so prefer actual workload labels. */}}
{{- if not (or $l.target $l.node $l.pod $l.deployment $l.statefulset $l.daemonset $l.persistentvolumeclaim $l.cronjob $l.job_name $l.tuner $l.name $l.ups $l.backup $l.repository $l.scale_set $l.datasource_uid) -}}
  {{- with $l.instance }}{{ $target = printf "%sinstance=%s " $target . }}{{ end -}}
{{- end -}}
{{- if not (or $l.target $l.instance $l.node $l.pod $l.deployment $l.statefulset $l.daemonset $l.persistentvolumeclaim $l.cronjob $l.job_name $l.tuner $l.name $l.ups $l.backup $l.repository $l.scale_set $l.datasource_uid) }}{{ with $l.job }}{{ $target = printf "%sjob=%s" $target . }}{{ end }}{{ end -}}
{{- with .Annotations.display_target }}{{ $target = . }}{{ end -}}
{{- if $target }}対象: {{ printf "%.250s" (reReplaceAll "[\\r\\n*_`<>@\\[\\]]" " " $target) }}{{ "\n" }}{{ end -}}
{{- end }}

{{ define "my-infra.alert" -}}
**{{ template "my-infra.state" . }} | {{ template "my-infra.severity" . }} | {{ template "my-infra.name" . }}**
{{ template "my-infra.context" . -}}
{{- if eq .Labels.alertname "DatasourceError" }}{{ if eq .Status "resolved" }}評価エラー状態が解消しました。実サービスの復旧を意味するものではありません。{{ else }}評価エラー: 監視対象の障害・復旧は判定できません。{{ end }}
{{ else if eq .Labels.alertname "DatasourceNoData" }}{{ if eq .Status "resolved" }}データなし状態が解消しました。実サービスの復旧を意味するものではありません。{{ else }}データなし: 監視対象の障害・復旧は判定できません。{{ end }}
{{ else if eq .Status "resolved" }}アラート条件が解消しました。必要に応じて実サービスを確認してください。
{{ else -}}
{{- with or .Annotations.description .Annotations.summary }}概要: {{ printf "%.250s" (reReplaceAll "[\\r\\n*_`<>@\\[\\]]" " " .) }}
{{ end -}}
{{- end -}}
{{- with .Annotations.details }}詳細: {{ printf "%.380s" (reReplaceAll "[\\r\\n*_`<>@\\[\\]]" " " .) }}{{ "\n" }}{{ end -}}
{{- $url := or .GeneratorURL .DashboardURL -}}
{{- if and $url (le (len $url) 350) (match "^https?://[^<>\\s]+$" $url) }}[Grafanaで詳細を確認](<{{ $url }}>){{ "\n" }}{{ end -}}
{{- with .Annotations.runbook_url -}}
{{- if and (le (len .) 300) (match "^https?://[^<>\\s]+$" .) }}[対処手順](<{{ . }}>){{ "\n" }}{{ end -}}
{{- end -}}
{{- if eq .Status "resolved" -}}
  {{- if not .EndsAt.IsZero }}復旧: {{ .EndsAt.UTC.Format "2006-01-02 15:04:05 UTC" }}{{ "\n" }}{{ end -}}
{{- else -}}
  {{- if not .StartsAt.IsZero }}発生: {{ .StartsAt.UTC.Format "2006-01-02 15:04:05 UTC" }}{{ "\n" }}{{ end -}}
{{- end -}}
{{- end }}

{{ define "my-infra.message" -}}
{{- $body := "" -}}
{{- $shown := "" -}}
{{/* Firing critical first, then other firing, then resolved. Build a bounded
     body before Discord's destructive 2000-rune truncation can occur.
     Count runes with RE2 so Japanese text uses the available space. */}}
{{- range .Alerts.Firing -}}
  {{- if eq (toLower .Labels.severity) "critical" -}}
    {{- $row := tmpl.Exec "my-infra.alert" . -}}
    {{- if le (len (reReplaceAll "(?s)." "x" (printf "%s%s\n" $body $row))) 1650 }}{{ $body = printf "%s%s\n" $body $row }}{{ $shown = printf "%sx" $shown }}{{ end -}}
  {{- end -}}
{{- end -}}
{{- range .Alerts.Firing -}}
  {{- if ne (toLower .Labels.severity) "critical" -}}
    {{- $row := tmpl.Exec "my-infra.alert" . -}}
    {{- if le (len (reReplaceAll "(?s)." "x" (printf "%s%s\n" $body $row))) 1650 }}{{ $body = printf "%s%s\n" $body $row }}{{ $shown = printf "%sx" $shown }}{{ end -}}
  {{- end -}}
{{- end -}}
{{- range .Alerts.Resolved -}}
  {{- $row := tmpl.Exec "my-infra.alert" . -}}
  {{- if le (len (reReplaceAll "(?s)." "x" (printf "%s%s\n" $body $row))) 1650 }}{{ $body = printf "%s%s\n" $body $row }}{{ $shown = printf "%sx" $shown }}{{ end -}}
{{- end -}}
発生 {{ len .Alerts.Firing }}件 / 復旧 {{ len .Alerts.Resolved }}件（本文表示 {{ len $shown }}/{{ len .Alerts }}件）
{{ $body }}
{{- if lt (len $shown) (len .Alerts) }}文字数上限のため一部省略。全対象はGrafanaで確認してください。{{ "\n" }}{{ end -}}
{{- if and (le (len .ExternalURL) 100) (match "^https?://[^<>\\s]+$" .ExternalURL) }}[全アラートをGrafanaで確認](<{{ reReplaceAll "/+$" "" .ExternalURL }}/alerting/list>){{ end }}
{{- end }}
