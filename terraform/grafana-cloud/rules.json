[
  {
    "id": "cpu-busy",
    "title": "Host CPU busy",
    "expression": "(100 * (1 - avg by(instance) (rate(node_cpu_seconds_total{job=~\"node_vm|node_kubernetes\",mode=\"idle\"}[5m]))) > bool 85) or vector(0)",
    "duration": "15m",
    "severity": "warn",
    "service": "hosts",
    "group": "capacity",
    "feature": "",
    "description": "CPU >85% for 15m. Identify sustained consumers; CPU alone does not page."
  },
  {
    "id": "memory-warn",
    "title": "Host memory warn",
    "expression": "(100 * node_memory_MemAvailable_bytes{job=~\"node_vm|node_kubernetes\"} / node_memory_MemTotal_bytes{job=~\"node_vm|node_kubernetes\"} < bool 15 and (100 * node_memory_MemAvailable_bytes{job=~\"node_vm|node_kubernetes\"} / node_memory_MemTotal_bytes{job=~\"node_vm|node_kubernetes\"} >= 5)) or vector(0)",
    "duration": "10m",
    "severity": "warn",
    "service": "hosts",
    "group": "capacity",
    "feature": "",
    "description": "Host memory warn"
  },
  {
    "id": "memory-critical",
    "title": "Host memory critical",
    "expression": "(100 * node_memory_MemAvailable_bytes{job=~\"node_vm|node_kubernetes\"} / node_memory_MemTotal_bytes{job=~\"node_vm|node_kubernetes\"} < bool 5) or vector(0)",
    "duration": "5m",
    "severity": "critical",
    "service": "hosts",
    "group": "capacity",
    "feature": "",
    "description": "Host memory critical"
  },
  {
