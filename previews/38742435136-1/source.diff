+<script>
+const frame=document.querySelector('#diagram'),note=document.querySelector('#note');
+const views=['index','home_apps','delivery','secrets','observability','placement'];
+const initial=new URLSearchParams(location.hash.slice(1));
+let view=initial.get('view')||location.hash.match(/\/view\/([^/?]+)/)?.[1]||'index';if(!views.includes(view))view='index';
+const defaults={runtime:true,admin:true,deploy:true,secret:true,observe:true,query:true,backup:true};
+window.myInfraLineFilters={...defaults};
+try{const saved=JSON.parse(localStorage.getItem('my-infra-line-filters'));for(const kind of Object.keys(defaults))if(typeof saved?.[kind]==='boolean')window.myInfraLineFilters[kind]=saved[kind]}catch{}
+const toggles=[...document.querySelectorAll('[data-kind]')];
+function sendFilters(){for(const input of toggles)input.checked=window.myInfraLineFilters[input.dataset.kind];try{localStorage.setItem('my-infra-line-filters',JSON.stringify(window.myInfraLineFilters))}catch{}frame.contentWindow.postMessage({type:'my-infra:line-filters',filters:window.myInfraLineFilters},location.origin)}
