+    component client 'VLAN30 / 192.168.30.0/24'
+    component guest 'VLAN31 / guest' { description '他VLANへの通信は不可。全VLAN間を到達可能として描かない。' }
+    component iot 'VLAN40 / 192.168.40.0/24'
+  }
+  extend oke {
+    component services 'STG共通Application'
+    component network 'OCI network' {
+      component public_api '公開API・LB subnet'
+      component private_workers 'private worker subnet'
+      component nat 'NAT gateway / reserved IP'
+      component igw 'Internet gateway'
+      component service_gateway 'Service Gateway / Oracle Services'
+    }
+    component workers 'base / burst node pool' { description 'worker compartmentの権限はAutoscalerへ限定。control plane・公開APIと区別する。' }
+  }
+  extend reventer {
+    component platform 'PRD共通基盤・外部所有アプリ登録' { description '共通アドオンとApplication登録はmy-infra。アプリ実装・PRDクラスタ本体の所有はreventer。' }
