---
server: https://{{ lb.vip }}:9345
token: "{{ rke2_node_token | trim }}"
node-name: "{{ hostname }}"
node-ip: "{{ ansible_host | default(inventory_hostname) }}"
node-label:
  - "node.miutaku/role=agent"
{% if kubernetes_hostname_compat is defined %}
  # Preserve immutable local-path PV node affinity after an RKE2 node rename.
  - "kubernetes.io/hostname={{ kubernetes_hostname_compat }}"
{% endif %}
{% if proxmox_node is defined %}
  - "topology.miutaku/proxmox-node={{ proxmox_node }}"
{% endif %}
{% if tnlastation_batch_encode | default(false) | bool %}
  # Low-priority batch encoding only. Streaming workloads remain amd64-only.
  - "workload.miutaku/tnlastation-batch-encode=true"
{% endif %}
{% if 'rke2-dvb-worker' in group_names %}
  # Physical Earthsoft PT3 tuner passed through from the Proxmox host.
  - "hardware.miutaku/dvb=true"
  - "hardware.miutaku/pt3=true"
{% endif %}
{% if ansible_architecture in ['aarch64', 'arm64'] or 'rke2-dvb-worker' in group_names %}
node-taint:
{% if ansible_architecture in ['aarch64', 'arm64'] %}
  # Generic workloads may use amd64-only images or network exports.
  - "node.miutaku/architecture=arm64:NoSchedule"
{% endif %}
{% if 'rke2-dvb-worker' in group_names %}
  # Keep generic workloads off the physical tuner node.
  - "hardware.miutaku/dvb=true:NoSchedule"
{% endif %}
{% endif %}
