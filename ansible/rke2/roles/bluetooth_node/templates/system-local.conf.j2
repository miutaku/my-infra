<?xml version="1.0"?>
<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>
  <!--
    Loockit/Bleak reconnects use the host system bus. Keep enough headroom for
    BlueZ itself while the Pod FD watchdog recycles a leaking client at 96 FDs.
  -->
  <limit name="max_connections_per_user">1024</limit>
</busconfig>
