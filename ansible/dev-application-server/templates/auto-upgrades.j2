// Managed by Ansible. Keep Ubuntu's default security origins enabled.
Unattended-Upgrade::Allowed-Origins {
    "${distro_id}:${distro_codename}-updates";
};
// Only the third-party repositories configured for this development host.
Unattended-Upgrade::Origins-Pattern {
{% for pattern in dev_auto_upgrade_origins %}
    "{{ pattern }}";
{% endfor %}
};
// Reboots require a successful notification on the previous evening.
Unattended-Upgrade::Automatic-Reboot "false";
