#!/usr/bin/env python3
"""Control GNOME display power saving from a TinyTuya illuminance sensor."""

import logging
import os
import subprocess
import time

import tinytuya


logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s %(levelname)s %(message)s",
)
LOG = logging.getLogger("tuya-light-display")

DEVICE_ID = os.environ["TUYA_DEVICE_ID"]
LOCAL_KEY = os.environ["TUYA_LOCAL_KEY"]
DEVICE_IP = os.environ["TUYA_DEVICE_IP"]
VERSION = float(os.getenv("TUYA_VERSION", "3.3"))
LUX_DPS = os.getenv("TUYA_LUX_DPS", "1")
LUX_SCALE = float(os.getenv("TUYA_LUX_SCALE", "1"))
POLL_INTERVAL = float(os.getenv("POLL_INTERVAL", "15"))
OFF_BELOW = float(os.getenv("DISPLAY_OFF_BELOW_LUX", "20"))
ON_ABOVE = float(os.getenv("DISPLAY_ON_ABOVE_LUX", "30"))
REQUIRED_SAMPLES = int(os.getenv("REQUIRED_SAMPLES", "2"))

DISPLAY_CONFIG = "org.gnome.Mutter.DisplayConfig"
DISPLAY_PATH = "/org/gnome/Mutter/DisplayConfig"


def set_display_power(enabled: bool) -> None:
    # Mutter PowerSaveMode: 0=on, 3=off. This preserves the sole logical
    # monitor configuration, unlike omitting the only monitor from gdctl.
    mode = 0 if enabled else 3
    subprocess.run(
        [
            "/usr/bin/gdbus",
            "call",
            "--session",
            "--dest",
            DISPLAY_CONFIG,
            "--object-path",
            DISPLAY_PATH,
            "--method",
            "org.freedesktop.DBus.Properties.Set",
            DISPLAY_CONFIG,
            "PowerSaveMode",
            f"<int32 {mode}>",
        ],
        check=True,
        timeout=10,
        capture_output=True,
        text=True,
    )
    LOG.info("Display output set to %s", "on" if enabled else "off")


def read_lux(device: tinytuya.Device) -> float:
    result = device.status()
    if not isinstance(result, dict) or not isinstance(result.get("dps"), dict):
        raise RuntimeError(f"unexpected TinyTuya response: {result!r}")
    dps = result["dps"]
    raw = dps.get(LUX_DPS, dps.get(int(LUX_DPS) if LUX_DPS.isdigit() else LUX_DPS))
    if isinstance(raw, bool) or not isinstance(raw, (int, float)):
        raise RuntimeError(f"DPS {LUX_DPS} is not numeric: {raw!r}")
    return float(raw) / LUX_SCALE


def main() -> None:
    if OFF_BELOW >= ON_ABOVE:
        raise ValueError("DISPLAY_OFF_BELOW_LUX must be below DISPLAY_ON_ABOVE_LUX")
    if LUX_SCALE <= 0 or REQUIRED_SAMPLES <= 0:
        raise ValueError("TUYA_LUX_SCALE and REQUIRED_SAMPLES must be positive")

    device = tinytuya.Device(DEVICE_ID, DEVICE_IP, LOCAL_KEY)
    device.set_version(VERSION)
    device.set_socketTimeout(5)

    display_on = True
    pending_state = None
    matching_samples = 0

    while True:
        try:
            lux = read_lux(device)
            LOG.info("Illuminance %.2f lx", lux)
            wanted = False if lux <= OFF_BELOW else True if lux >= ON_ABOVE else display_on

            if wanted == display_on:
                pending_state = None
                matching_samples = 0
            else:
                if wanted == pending_state:
                    matching_samples += 1
                else:
                    pending_state = wanted
                    matching_samples = 1
                if matching_samples >= REQUIRED_SAMPLES:
                    set_display_power(wanted)
                    display_on = wanted
                    pending_state = None
                    matching_samples = 0
        except Exception:
            # A sensor/network failure must not unexpectedly blank or wake a display.
            LOG.exception("Sensor poll or display control failed")
        time.sleep(POLL_INTERVAL)


if __name__ == "__main__":
    main()
