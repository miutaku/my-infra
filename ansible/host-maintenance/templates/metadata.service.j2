[Unit]
Description=Automatically upgrade PVE packages without OS reboot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
StateDirectory=host-maintenance
StateDirectoryMode=0700
LoadCredential=agent-config:/etc/host-maintenance/agent-config
ExecStart=/usr/local/sbin/host-maintenance-agent --update
UMask=0077
TimeoutStartSec=3h
